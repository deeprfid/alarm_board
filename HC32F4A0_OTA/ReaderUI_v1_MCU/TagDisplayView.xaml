<UserControl x:Class="ReaderManager.TagDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <!-- 顶栏标签：与输入框同高 30，文字垂直居中 → 上下对齐 -->
        <Style x:Key="tagFieldLabel" TargetType="Label" BasedOn="{StaticResource paramLabelStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- 顶栏输入框：完全自定义，灰色实线下划线 2px（同 OtaUpdateView otaUnderlineTextBox） -->
        <Style x:Key="tagFieldTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#FF9E9E9E" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
        <!-- 顶栏下拉框：非浮动 MaterialDesignComboBox（实线下划线，与 ConnectView 一致） -->
        <Style x:Key="tagFieldCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <!-- 行分隔：实线下边框（与标签盘点页一致） -->
        <Style TargetType="{x:Type ListViewItem}" x:Key="tagDisplayRowStyle"
               BasedOn="{StaticResource MaterialDesignGridViewItem}">
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 列头：实线底边 -->
        <Style TargetType="{x:Type GridViewColumnHeader}" x:Key="tagDisplayHeaderStyle"
               BasedOn="{StaticResource MaterialDesignGridViewColumnHeader}">
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,30,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========== 顶部：接口选择 + 控制（一行上下对齐，实线） ========== -->
        <Grid Grid.Row="0" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Content="{DynamicResource TagDisplay_interface}" Grid.Column="0"
                   Style="{StaticResource tagFieldLabel}" Margin="0,0,50,0" />

            <ComboBox x:Name="cbbChannel" Grid.Column="1" Style="{StaticResource tagFieldCombo}"
                      Width="120" Margin="0,0,50,0"
                      SelectionChanged="cbbChannel_SelectionChanged">
                <ComboBoxItem Content="{DynamicResource TagDisplay_ch_serial}" />
                <ComboBoxItem Content="{DynamicResource TagDisplay_ch_cdc}" />
                <ComboBoxItem Content="{DynamicResource TagDisplay_ch_winusb}" />
                <ComboBoxItem Content="{DynamicResource TagDisplay_ch_httptcp}" />
            </ComboBox>

            <TextBox x:Name="tbxAddr" Grid.Column="2" Style="{StaticResource tagFieldTextBox}"
                     Width="170" Margin="0,0,50,0" />

            <TextBox x:Name="tbxPort" Grid.Column="3" Style="{StaticResource tagFieldTextBox}"
                     Width="70" />

            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button x:Name="btnStart" Content="{DynamicResource TagDisplay_btn_start}"
                        Style="{StaticResource AccentSettingButtonStyle}" Click="btnStart_Click" />
                <Button x:Name="btnStop" Content="{DynamicResource TagDisplay_btn_stop}"
                        Style="{StaticResource AccentSettingButtonStyle}" Margin="8,0,0,0" Click="btnStop_Click" />
                <Button x:Name="btnClear" Content="{DynamicResource TagDisplay_btn_clear}"
                        Style="{StaticResource AccentSettingButtonStyle}" Margin="8,0,0,0" Click="btnClear_Click" />
            </StackPanel>
        </Grid>

        <!-- ========== 中部：标签列表（按行显示，实线分隔） ========== -->
        <ListView Grid.Row="1" x:Name="listTags" Margin="10,0,10,0"
                  Style="{StaticResource MaterialDesignListView}"
                  ItemContainerStyle="{StaticResource tagDisplayRowStyle}"
                  FontSize="12.5"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{DynamicResource TagDisplay_col_no}" Width="55" DisplayMemberBinding="{Binding No}" />
                    <GridViewColumn Header="{DynamicResource TagDisplay_col_epc}" Width="240" DisplayMemberBinding="{Binding Epc}" />
                    <GridViewColumn Header="{DynamicResource TagDisplay_col_reads}" Width="70" DisplayMemberBinding="{Binding Reads}" />
                    <GridViewColumn Header="{DynamicResource TagDisplay_col_ant}" Width="60" DisplayMemberBinding="{Binding Ant}" />
                    <GridViewColumn Header="{DynamicResource TagDisplay_col_bankdata}" Width="160" DisplayMemberBinding="{Binding BankData}" />
                    <GridViewColumn Header="{DynamicResource TagDisplay_col_prot}" Width="60" DisplayMemberBinding="{Binding Prot}" />
                    <GridViewColumn Header="{DynamicResource TagDisplay_col_rssi}" Width="60" DisplayMemberBinding="{Binding Rssi}" />
                    <GridViewColumn Header="{DynamicResource TagDisplay_col_freq}" Width="80" DisplayMemberBinding="{Binding Freq}" />
                    <GridViewColumn Header="{DynamicResource TagDisplay_col_phase}" Width="70" DisplayMemberBinding="{Binding Phase}" />
                    <GridViewColumn Header="{DynamicResource TagDisplay_col_time}" Width="130" DisplayMemberBinding="{Binding Time}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ========== 底部：接收状态/计数（实线分隔） ========== -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#100E3193" Margin="10,6,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Label x:Name="lblState" Content="{DynamicResource TagDisplay_state_idle}"
                       Style="{StaticResource paramLabelStyle}" FontSize="13" Foreground="#FF5C5C5C" />
                <Label x:Name="lblCount" Content="0"
                       Style="{StaticResource paramLabelStyle}" FontSize="13" Foreground="#FF0E3193" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
