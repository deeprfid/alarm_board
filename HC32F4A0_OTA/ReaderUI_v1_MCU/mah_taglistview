<UserControl x:Class="ReaderManager.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             d:DesignHeight="300"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="{x:Type GridViewColumnHeader}" 
               BasedOn="{StaticResource MahApps.Styles.GridViewColumnHeader}"
               x:Key="MyMouseOnHeader" >
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="AccentCircleButtonStyle"
                BasedOn="{StaticResource MahApps.Styles.Button.Circle}"
                TargetType="{x:Type ButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"   BorderThickness="0,0,0,2" BorderBrush="#100E3193">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="24*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.68*" />

                        </Grid.ColumnDefinitions>

                        <Label Content="{Binding Icon.ToolTip}"   Grid.Column="0"
                   FontSize="19" Foreground="{StaticResource MahApps.Brushes.AccentBase}"
                   VerticalAlignment="Center"
                   BorderBrush="{DynamicResource MahApps.Colors.Accent1}" />

                        <Button  x:Name="btnStart" Width="40" Height="40"
                          Style="{StaticResource MaterialDesignIconButton}"  Grid.Column="1"   
                          ToolTip="点击开始盘点" VerticalAlignment="Center"
                          Click="btnStart_Click"
                          HorizontalAlignment="Left"
                          Foreground="Green"
                          Background="{DynamicResource MaterialDesignTextFieldBoxBackground}">
                            <materialDesign:PackIcon Height="28" Width="28" Kind="Play" />
                        </Button>
                        <Button x:Name="btnStop" Width="40" VerticalAlignment="Center"  Grid.Column="2"
                                    Click="btnStop_Click"
                                    Height="40"
                                Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    HorizontalAlignment="Left"
                                    Foreground="Red"
                                    ToolTip="点击停止盘点"
                                    Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon  Kind="Stop" 
                                            Height="28"
                                            Width="28" />
                        </Button>
                        <Button x:Name="btnClear" Width="40" VerticalAlignment="Center" Grid.Column="3"
                                    Click="btnClear_Click"
                                    Height="40"
                                    Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    HorizontalAlignment="Left"
                                    ToolTip="点击清空列表"
                                    Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" />
                        </Button>
                        <Button x:Name="btnExport" Width="40" VerticalAlignment="Center" Grid.Column="4"
                                    Click="btnExport_Click"
                                    Height="40"
                                    Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    HorizontalAlignment="Left"
                                    ToolTip="点击导出列表"
                                    Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="FileExport" Width="20" Height="20" />
                        </Button>

                        <materialDesign:PackIcon Kind="ChartBar" Grid.Column="5" VerticalAlignment="Center"
                                                 HorizontalAlignment="Left" Width="25" Height="25"
                                                 Foreground="{StaticResource MahApps.Brushes.Accent2}" />

                        <Label x:Name="tbTagCount" Grid.Column="5" FontSize="38" HorizontalAlignment="Left" Margin="27,0,0,0"
                                   VerticalAlignment="Center"  Content="{Binding Items.Count, ElementName=dgTags}"
                                   Foreground="{StaticResource MahApps.Brushes.AccentBase}"/>


                    </Grid>
                </Grid>
            </Border>

            <ListView Grid.Row="1"  x:Name="dgTags"
                  FontSize="12.3"  GridViewColumnHeader.Click="Sort_Click" 
                  Margin="35,0,0,0"
                  MinWidth="770"                   
                  VirtualizingStackPanel.IsVirtualizing ="true"
                  VirtualizingStackPanel.VirtualizationMode ="Recycling" >
                <ListView.View >

                    <GridView x:Name="gvTags" ColumnHeaderContainerStyle="{StaticResource MyMouseOnHeader}" >
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_epc}" Width="261.408" DisplayMemberBinding="{Binding Epc}" />
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_readcount}" Width="66.13" DisplayMemberBinding="{Binding Reads}"/>
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_ant}" Width="50.57" DisplayMemberBinding="{Binding Ant}"/>
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_bankdata}"  Width="165.714" DisplayMemberBinding="{Binding BankData}"/>
                        <GridViewColumn Header="{DynamicResource Inventory_listview_colum_prot}" Width="59.128" DisplayMemberBinding="{Binding Prot}"/>
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_rssi}" Width="52.126" DisplayMemberBinding="{Binding Rssi}"/>
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_freq}" Width="62.24" DisplayMemberBinding="{Binding Freq}"/>
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_phase}" Width="60.684" DisplayMemberBinding="{Binding Phase}"/>
                    </GridView>

                </ListView.View>


            </ListView>
        </Grid >
    </ScrollViewer>
</UserControl>