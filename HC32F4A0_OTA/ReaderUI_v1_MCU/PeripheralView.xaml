<UserControl x:Class="ReaderManager.PeripheralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             d:DesignHeight="400"
             d:DesignWidth="800"
             IsVisibleChanged="UserControl_IsVisibleChanged"
             mc:Ignorable="d" Loaded="UserControl_Loaded" 
             SizeChanged="UserControl_SizeChanged" >

    <ScrollViewer
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="23*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"  Grid.Column="1"  BorderThickness="0,0,0,2" BorderBrush="#100E3193">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="{DynamicResource HamburgerMenu_peripherals}"  Grid.Column="0"
                   FontSize="19" Foreground="{StaticResource MahApps.Brushes.AccentBase}"
                   VerticalAlignment="Center"
                   BorderBrush="{DynamicResource MahApps.Colors.Accent1}" />

                </Grid>
            </Border>


            <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" x:Name="gdMain"
                  MinHeight="448" MinWidth="577">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" MinHeight="30"/>
                    <RowDefinition Height="48" MinHeight="48"/>
                    <RowDefinition Height="20" MinHeight="20"/>
                    <RowDefinition Height="30" MinHeight="30"/>
                    <RowDefinition Height="48" MinHeight="48"/>
                    <RowDefinition Height="20" MinHeight="20"/>
                    <RowDefinition Height="170" MinHeight="170"/>
                </Grid.RowDefinitions>

                <Label Content="{DynamicResource PeripheralView_GPIstatus}" Grid.Row="0" 
                       Style="{StaticResource paramLabelStyle}" />
                <Grid Grid.Row="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />

                    </Grid.ColumnDefinitions>

                    <Label Content="GPI1" Grid.Column="0" Style="{StaticResource paramLabelStyle}"
                         Margin="20,0,0,0" IsEnabled="{Binding EnableGpi1}"
                       FontSize="14"/>
                    <Button Width="40" Height="40" Margin="70,0,0,0" x:Name="btnGpi1"
                            IsEnabled="{Binding EnableGpi1}"
                          Style="{StaticResource MaterialDesignIconButton}"  Grid.Column="0"   
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          Foreground="Green"
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"
                          Background="#100E3193"/>

                    <Label Content="GPI2" Grid.Column="1" Style="{StaticResource paramLabelStyle}"
                         Margin="20,0,0,0" IsEnabled="{Binding EnableGpi2}"
                       FontSize="14"/>
                    <Button Width="40" Height="40" Margin="70,0,0,0" x:Name="btnGpi2"
                          Style="{StaticResource MaterialDesignIconButton}"  Grid.Column="1"   
                            IsEnabled="{Binding EnableGpi2}"
                           VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          Foreground="Green"
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"
                          Background="#100E3193"/>

                    <Label Content="GPI3" Grid.Column="2" Style="{StaticResource paramLabelStyle}"
                         Margin="20,0,0,0" IsEnabled="{Binding EnableGpi3}"
                       FontSize="14"/>
                    <Button Width="40" Height="40" Margin="70,0,0,0" IsEnabled="{Binding EnableGpi3}"
                          Style="{StaticResource MaterialDesignIconButton}"  Grid.Column="2"   
                          VerticalAlignment="Center"
                            x:Name="btnGpi3"
                          HorizontalAlignment="Left"
                          Foreground="Green"
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"
                          Background="#100E3193"/>

                    <Label Content="GPI4" Grid.Column="3" Style="{StaticResource paramLabelStyle}"
                         Margin="20,0,0,0" IsEnabled="{Binding EnableGpi4}"
                       FontSize="14"/>
                    <Button  Width="40" Height="40" Margin="70,0,0,0" IsEnabled="{Binding EnableGpi4}"
                          Style="{StaticResource MaterialDesignIconButton}"  Grid.Column="3"   
                           VerticalAlignment="Center"
                             x:Name="btnGpi4"
                          HorizontalAlignment="Left"
                          Foreground="Green"
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"
                          Background="#100E3193"/>

                    <Button  VerticalAlignment="Center"  Grid.Column="4"   x:Name="btnGet"
                             IsEnabled="{Binding IsConnect}" Click="btnGet_Click"
                                    HorizontalAlignment="Right" Height="25"
                                    Content="{DynamicResource ParamSettings_button_get}"                            
                                    Style="{StaticResource AccentSettingButtonStyle}" />

                </Grid>
                <Border  Style="{StaticResource paramBorderStyle}" Grid.Row="2" />

                <Label Content="{DynamicResource PeripheralView_GPOstatus}" 
                       Grid.Row="3" Style="{StaticResource paramLabelStyle}" />

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />

                    </Grid.ColumnDefinitions>
                    <Label Content="GPO1" Grid.Column="0" Style="{StaticResource paramLabelStyle}"
                         Margin="20,0,0,0" IsEnabled="{Binding EnableGpo1}"
                       FontSize="14"/>
                    <ToggleButton Grid.Column="0" Margin="70,0,0,0"
                                  IsEnabled="{Binding EnableGpo1}"
                          Style="{StaticResource gpoTbStateStyle}"
                          x:Name="btnGpo1"
                          ToolTip="{DynamicResource PeripheralView_ClickToChangeState}"                             
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"       
                          materialDesign:ToggleButtonAssist.OnContent="{DynamicResource PeripheralView_GPIOstate_High}" />

                    <Label Content="GPO2" Grid.Column="1" Style="{StaticResource paramLabelStyle}"
                         Margin="20,0,0,0" IsEnabled="{Binding EnableGpo2}"
                       FontSize="14"/>
                    <ToggleButton Grid.Column="1" Margin="70,0,0,0"
                                   IsEnabled="{Binding EnableGpo2}"
                          Style="{StaticResource gpoTbStateStyle}"
                          x:Name="btnGpo2"
                          ToolTip="{DynamicResource PeripheralView_ClickToChangeState}"                             
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"       
                          materialDesign:ToggleButtonAssist.OnContent="{DynamicResource PeripheralView_GPIOstate_High}" />

                    <Label Content="GPO3" Grid.Column="2" Style="{StaticResource paramLabelStyle}"
                         Margin="20,0,0,0"  IsEnabled="{Binding EnableGpo3}"
                       FontSize="14"/>
                    <ToggleButton Grid.Column="2" Margin="70,0,0,0"
                                   IsEnabled="{Binding EnableGpo3}"
                          Style="{StaticResource gpoTbStateStyle}"
                          x:Name="btnGpo3"
                          ToolTip="{DynamicResource PeripheralView_ClickToChangeState}"                             
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"       
                          materialDesign:ToggleButtonAssist.OnContent="{DynamicResource PeripheralView_GPIOstate_High}" />

                    <Label Content="GPO4" Grid.Column="3" Style="{StaticResource paramLabelStyle}"
                         Margin="20,0,0,0"  IsEnabled="{Binding EnableGpo4}"
                       FontSize="14"/>
                    <ToggleButton Grid.Column="3" Margin="70,0,0,0"
                                   IsEnabled="{Binding EnableGpo4}"
                          Style="{StaticResource gpoTbStateStyle}"
                          x:Name="btnGpo4"
                          ToolTip="{DynamicResource PeripheralView_ClickToChangeState}"                             
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"       
                          materialDesign:ToggleButtonAssist.OnContent="{DynamicResource PeripheralView_GPIOstate_High}" />
                    <Button  VerticalAlignment="Center"  Grid.Column="4"  x:Name="btnSet"                                 
                                    HorizontalAlignment="Right" Height="25"
                             IsEnabled="{Binding IsConnect}" Click="btnSet_Click"
                                    Content="{DynamicResource ParamSettings_button_set}"  
                                    Style="{StaticResource AccentSettingButtonStyle}" />
                </Grid>
                <Border  Style="{StaticResource paramBorderStyle}" Grid.Row="5" />

                <Border Grid.Row="6" IsEnabled="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Label Content="PSAM" Grid.Row="0" Style="{StaticResource paramLabelStyle}" />
                        <TextBox x:Name="tbSendCmd" Style ="{StaticResource paramTextBoxStyle}"  Grid.Row="1"
                             Grid.Column="0" Width="500" MinWidth="500" HorizontalAlignment="Left"
                         materialDesign:HintAssist.Hint="{DynamicResource PeripheralView_Psam_SendCmd}"  />

                        <TextBox x:Name="tbRecvCmd" Style ="{StaticResource paramTextBoxStyle}"  Grid.Row="2"
                             Grid.Column="1" IsReadOnly="True" Width="500" MinWidth="500"
                             HorizontalAlignment="Left"
                         materialDesign:HintAssist.Hint="{DynamicResource PeripheralView_Psam_RecvCmd}"  />
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />

                            </Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="0"  
                                  ItemsSource="{DynamicResource List_PeripheralView_PsamSlot}"  
                                  HorizontalAlignment="Left"  Margin="20,0,0,0" x:Name="cbbPsamSlot"
                                  materialDesign:HintAssist.Hint="{DynamicResource PeripheralView_Psam_PsamSlot}" />
                            <Button  VerticalAlignment="Center"  Grid.Column="4" Margin="0,20, 0, 0"                                   
                                    HorizontalAlignment="Right" Height="25"
                                    Content="{DynamicResource PeripheralView_Psam_bntSend}"                                    
                                    ToolTip="{DynamicResource PeripheralView_Psam_bntSendTip}" 
                                    Style="{StaticResource AccentSettingButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Grid >
    </ScrollViewer>
</UserControl>