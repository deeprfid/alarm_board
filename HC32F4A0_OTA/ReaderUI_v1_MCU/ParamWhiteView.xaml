<UserControl 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReaderManager" xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"  
             xmlns:controlzex="urn:controlzex" x:Class="ReaderManager.ParamWhiteView"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <x:Array x:Key="storage" Type="{x:Type sys:String}">
            <sys:String>5</sys:String>
            <sys:String>10</sys:String>
            <sys:String>20</sys:String>
            <sys:String>30</sys:String>
        </x:Array>


        <Style TargetType="{x:Type ListView}" x:Key="ListViewBorderStyle">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid x:Name="gdMain" >

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" >
                    <ListView ScrollViewer.VerticalScrollBarVisibility="Visible" Style="{StaticResource ListViewBorderStyle}" Grid.Row="1"  x:Name="listWhite" BorderBrush="Black" BorderThickness="1" 
                     FontSize="12.5" Margin="20,10,10,0" MinWidth="300" MinHeight ="300" MaxHeight="300" >
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Padding" Value="0,1,0,1"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View >
                            <GridView x:Name="lvWhite" >
                                <GridViewColumn  Header="{DynamicResource ParamSettings_white_listNo}" Width="150" DisplayMemberBinding="{Binding no}" />
                                <GridViewColumn  Header="{DynamicResource ParamSettings_white_listCode}" Width="250" DisplayMemberBinding="{Binding tag}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                </Grid>

                <Grid Grid.Row="1" Margin="0,15,0,0" Cursor="">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Button x:Name="btnGet" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_button_get}" Grid.Column="0" VerticalAlignment="Bottom" Width="70" Click="btnGet_Click" FontWeight="Normal" Margin="45,0,45,0"/>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Button x:Name="btnSet" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_button_set}" Grid.Column="1"  VerticalAlignment="Center"  Width="70" Click="btnSet_Click" FontWeight="Normal"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Button x:Name="btnClear" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_eas_easClear}" VerticalAlignment="Center"  Width="70" Click="btnClear_Click"  FontWeight="Normal"/>
                    </Grid>
                    <Grid Grid.Column="3">
                        <Button x:Name="btnReadFile" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_white_readfile}" Grid.Column="2"  VerticalAlignment="Center"  Width="80" Click="btnReadFile_Click"/>
                    </Grid>
                    <Grid Grid.Column="4">
                        <Button x:Name="btnWhiteFile" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_white_writefile}" Grid.Column="3"  VerticalAlignment="Center"  Width="80" Click="btnWriteFile_Click"/>
                    </Grid>

                </Grid>

                <Grid Grid.Row="2" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Label  Style="{StaticResource paramLabelStyle}" FontSize="13" Content="{DynamicResource ParamSettings_ParamInter_ipaddr}" HorizontalAlignment="Left" Margin="20,10,0,0" HorizontalContentAlignment="Center"  />
                        <ComboBox x:Name="cbDevIp" Style="{StaticResource paramComboBoxStyle}"   IsEnabled="{Binding EnableFreqHopMode}"  Width="150" VerticalAlignment="Center" HorizontalAlignment="Center" IsEditable="True" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="tbResult" Text="" VerticalAlignment="Bottom" Width="300" FontSize="20" BorderThickness="0,0,0,0" Margin="0,0,0,0" controlzex:KeyboardNavigationEx.AlwaysShowFocusVisual="True" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
