<UserControl x:Class="ReaderManager.FlyBottomInvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Loaded="Grid_Loaded" DataContextChanged="Grid_DataContextChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="7" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="15" />

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="18" />
        </Grid.ColumnDefinitions>

        <Label Content="{DynamicResource FlyView_Bottom_Inv_Freq_TagNumber}" Grid.Row="1" Grid.Column="2" 
                   FontSize="14" Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                   VerticalAlignment="Center" HorizontalAlignment="Left"/>

        <Label Content="{DynamicResource FlyView_Bottom_Inv_Ant_TagNumber}" Grid.Row="1" Grid.Column="1" 
                   FontSize="14" Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                   VerticalAlignment="Center" HorizontalAlignment="Left"/>

        <Button  x:Name="btnStart" Width="28" Height="28" 
                 Grid.Row="1" Grid.Column="2" Click="Button_Click"
                          Style="{StaticResource MaterialDesignIconButton}" 
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          ToolTip="{DynamicResource FlyView_Bottom_Inv_Refresh}"
                          Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                          Background="{DynamicResource MaterialDesignTextFieldBoxBackground}">
            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" />
        </Button>



        <lvc:CartesianChart x:Name="ccStickChart" Grid.Row="2" Grid.Column="2" >
            <lvc:CartesianChart.DataTooltip>
                <lvc:DefaultTooltip SelectionMode="OnlySender" />
            </lvc:CartesianChart.DataTooltip>
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="{DynamicResource FlyView_Bottom_Inv_Freq}"  Labels="{Binding xlabelslist}" >
                    <lvc:Axis.Separator>
                        <lvc:Separator Step="1" />
                    </lvc:Axis.Separator>
                </lvc:Axis>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="{DynamicResource FlyView_Bottom_Inv_TagNumber}" MinValue="0" />
            </lvc:CartesianChart.AxisY>
                            
        </lvc:CartesianChart>

        <lvc:PieChart  x:Name="pcPicChart" Grid.Row="2" Grid.Column="1" Margin="0,10,20,10">
 
        </lvc:PieChart>
        
    </Grid>
</UserControl>
