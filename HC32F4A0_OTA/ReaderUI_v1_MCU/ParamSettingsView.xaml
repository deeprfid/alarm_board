<UserControl x:Class="ReaderManager.ParamSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"

             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             mc:Ignorable="d"             
             d:DesignHeight="450" d:DesignWidth="650">
    <UserControl.Resources>
        <sys:String x:Key="TabItemHeader1">Eas</sys:String>
    </UserControl.Resources>

    <ScrollViewer
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">

        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="23*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"  Grid.Column="1"  BorderThickness="0,0,0,2" BorderBrush="#100E3193">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Content="{DynamicResource HamburgerMenu_settings}"  Grid.Column="0"
                   FontSize="19" Foreground="{StaticResource MahApps.Brushes.AccentBase}"
                   VerticalAlignment="Center"
                   BorderBrush="{DynamicResource MahApps.Colors.Accent1}" />
                    <Button x:Name="btnGet" VerticalAlignment="Center"  Grid.Column="1" Margin="0,0, 200, 0"                                   
                                    HorizontalAlignment="Right"
                                    IsEnabled="{Binding IsConnect}"
                                    Content="{DynamicResource ParamSettings_button_get}"                                    
                                    ToolTip="{DynamicResource ParamSettings_button_set_clicktoget}" 
                                    Style="{StaticResource AccentSettingButtonStyle}" Click="btnGet_Click" />

                    <Button x:Name="btnSet" VerticalAlignment="Center"  Grid.Column="1" Margin="0,0, 100, 0" 
                                    Click="btnSet_Click"
                                    IsEnabled="{Binding IsConnect}"
                                    HorizontalAlignment="Right"
                                    Content="{DynamicResource ParamSettings_button_set}"                                                                    
                                    ToolTip="{DynamicResource ParamSettings_button_set_clicktoset}"
                                    Style="{StaticResource AccentSettingButtonStyle}" />
                    <Button x:Name="btnSest" VerticalAlignment="Center"  Grid.Column="1" Margin="0,0, 0, 0" 
                                    Click="btnPerpetualSet_Click"
                                    IsEnabled="{Binding IsConnect}"
                                    HorizontalAlignment="Right"
                                    Content="{DynamicResource ParamSettings_button_set_perpetual}"                                                                    
                                    ToolTip="{DynamicResource ParamSettings_button_set_clicktoset}"
                                    Style="{StaticResource AccentSettingButtonStyle}" />

                    <!--<Button x:Name="btnSest"  Grid.Column="1" 
                                    Click="btnPerpetualSet_Click"
                                    IsEnabled="{Binding IsConnect}"
                                    HorizontalAlignment="Left"
                                    Content="{DynamicResource ParamSettings_button_set_perpetual}"                                                                    
                                    ToolTip="{DynamicResource ParamSettings_button_set_clicktoset}"
                                    Style="{StaticResource AccentSettingButtonStyle}" Margin="382,0,0,0" />-->
                </Grid>
            </Border>

            <TabControl  Grid.Column="1" Grid.Row="1"  x:Name="tcParamMuem"
                         MinHeight="448" MinWidth="577" 
                         SelectionChanged="SelectionChanged"
                        mah:TabControlHelper.Underlined="TabItems" 
                        mah:TabControlHelper.UnderlinePlacement="Right"                   
                    mah:HeaderedControlHelper.HeaderFontSize="15"                    
                    TabStripPlacement="Top" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                <TabItem Header="{DynamicResource ParamSettings_tabitem_setting_ant}" >
                    <local:ParamAntsView/>
                </TabItem>
                <TabItem Header="{DynamicResource ParamSettings_tabitem_setting_inventory}">
                    <local:ParamInvView/>
                </TabItem>
                <TabItem Header="{DynamicResource ParamSettings_tabitem_setting_network}" >
                    <local:ParamHwInterfaceView />
                </TabItem>

                <TabItem Header="{DynamicResource ParamSettings_tabitem_setting_advance}">
                    <local:ParamAdvanceView />
                </TabItem>

                <TabItem Header="{DynamicResource ParamSettings_tabitem_setting_eas}">
                    <local:ParamEasView />
                </TabItem>

                <TabItem Header="{DynamicResource ParamSettings_tabitem_setting_white}">
                    <local:ParamWhiteView />
                </TabItem>
                
                <TabItem Header="{DynamicResource ParamSettings_tabitem_setting_tag}">
                    <local:ParamTagView />
                </TabItem>

                <TabItem Header="{DynamicResource ParamSettings_tabitem_setting_log}">
                    <local:ParamLogView />
                </TabItem>
                <TabItem Header="{DynamicResource ParamSettings_tabitem_setting_mptt}">
                    <local:ParamStoreView />
                </TabItem>
                <TabItem Header="{DynamicResource ParamSettings_tabitem_setting_tagdisplay}">
                    <local:TagDisplayView />
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
