<UserControl x:Class="ReaderManager.ParamHwInterfaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             SizeChanged="UserControl_SizeChanged" Loaded="UserControl_Loaded"
             IsVisibleChanged="UserControl_IsVisibleChanged"
             IsEnabled="{Binding EnableIp}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <x:Array x:Key="AuthModeItems" Type="sys:String">
            <sys:String>OPEN</sys:String>
            <sys:String>OPEN WEP</sys:String>
            <sys:String>SHARED WEP</sys:String>
            <sys:String>WPA-PSK</sys:String>
            <sys:String>WPA2-PSK</sys:String>
        </x:Array>
    </UserControl.Resources>

    <Grid x:Name="gdMain" Margin="0,10,0,0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="30" MinHeight="30"/>
            <RowDefinition Height="48" MinHeight="48"/>
            <RowDefinition Height="20" MinHeight="20"/>
            <RowDefinition Height="78" MinHeight="78"/>
            <RowDefinition Height="20" MinHeight="20"/>
        </Grid.RowDefinitions>


        <Label Content="{DynamicResource ParamSettings_ParamInter_ipsettings}" 
               Grid.Row="0" Style="{StaticResource paramLabelStyle}" />
        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="19*" />
                <ColumnDefinition Width="61*"/>
                <ColumnDefinition Width="80*" />
                <ColumnDefinition Width="80*" />
                <ColumnDefinition Width="80*" />
                <ColumnDefinition Width="80*" />
            </Grid.ColumnDefinitions>

            <TextBox Style ="{StaticResource paramTextBoxStyle}"                             
                             Grid.Column="0"       Text="{Binding Ip}"      
                         materialDesign:HintAssist.Hint="{DynamicResource ParamSettings_ParamInter_ipaddr}" Grid.ColumnSpan="2" Margin="20,0,20,0"  />

            <TextBox Style ="{StaticResource paramTextBoxStyle}" 
                             Grid.Column="2"  Text="{Binding SubnetMask}" 
                         materialDesign:HintAssist.Hint="{DynamicResource ParamSettings_ParamInter_subnetmask}" Margin="20,0,20,0" />

            <TextBox Style ="{StaticResource paramTextBoxStyle}" 
                             Grid.Column="3" Text="{Binding Gateway}" 
                         materialDesign:HintAssist.Hint="{DynamicResource ParamSettings_ParamInter_gateway}" Margin="20,0,20,0"  />
        </Grid>
        <Border  Style="{StaticResource paramBorderStyle}"  Grid.Row="2" />

        <Grid Grid.Row="3" IsEnabled="{Binding EnableWireless}">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <mah:ToggleSwitch  Grid.Row="0"  Grid.Column="0" Grid.ColumnSpan="2"
                               x:Name="tsWirelessSettings" IsOn="{Binding IsWirelessOn}"
                           Style="{StaticResource paramToggleSwitchStyle}"
                              OffContent="{DynamicResource ParamSettings_ParamInter_tsWirelessSettings_off}" 
                              OnContent="{DynamicResource ParamSettings_ParamInter_tsWirelessSettings_on}" />

            <TextBox Style ="{StaticResource paramTextBoxStyle}"  Text="{Binding SSID}" Grid.Row="1"                          
                             Grid.Column="0"  IsEnabled="{Binding ElementName=tsWirelessSettings,Path=IsOn}"               
                         materialDesign:HintAssist.Hint="SSID"  />

            <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="1" Grid.Row="1" 
                      IsEnabled="{Binding ElementName=tsWirelessSettings,Path=IsOn}"  
                      ItemsSource="{StaticResource AuthModeItems}" SelectedIndex="{Binding AuthMode}"
                       materialDesign:HintAssist.Hint="{DynamicResource ParamSettings_ParamInter_authmode}"  />

            <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="2" x:Name="cbbKeyType" Grid.Row="1" 
                      IsEnabled="{Binding ElementName=tsWirelessSettings,Path=IsOn}"  SelectedIndex="{Binding KeyType}"
                      ItemsSource="{DynamicResource List_ParamSettings_ParamInter_KeyType}"
                       materialDesign:HintAssist.Hint="{DynamicResource ParamSettings_ParamInter_keytype}"  />

            <TextBox Style ="{StaticResource paramTextBoxStyle}"  Text="{Binding Key}"  Grid.Row="1"                        
                             Grid.Column="3"   IsEnabled="{Binding ElementName=tsWirelessSettings,Path=IsOn}"                
                         materialDesign:HintAssist.Hint="KEY"  />
        </Grid>

        <Border  Style="{StaticResource paramBorderStyle}" Grid.Row="4" />

    </Grid>
</UserControl>
