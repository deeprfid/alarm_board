<UserControl x:Class="ReaderManager.ActiveModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="2800" d:DesignWidth="800">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:ArrayContainsValueConverter x:Key="ArrayContainsValueConverter" />
        <local:RangeValidationRule x:Key="RangeValidationRule" />
        
        <Style BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}" x:Key="paramComboBoxStyle"
               TargetType="ComboBox" >
            <Setter Property="Margin" Value="20,0,20,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85" />
            <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Loaded="Grid_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="23*" />
                <!--<ColumnDefinition Width="2*" />-->
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="1"  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="100*"/>
                    <ColumnDefinition Width="40*" />
                    <ColumnDefinition Width="40*" />
                    <ColumnDefinition Width="40*" />
                    <ColumnDefinition Width="40*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource ActiveMode_ReaderIp}" FontSize="13"/>
                <TextBox x:Name="IpString" Grid.Column="1" Style ="{StaticResource paramTextBoxStyle}"
                         materialDesign:HintAssist.Hint="{DynamicResource Connect_label_ip}" GotFocus="IpString_GotFocus" />
                <Button x:Name="btnGet" VerticalAlignment="Center"  Grid.Column="2" Margin="0,0, 20, 0"                                   
                                    HorizontalAlignment="Right"
                                    Content="{DynamicResource ParamSettings_button_get}"                                    
                                    ToolTip="{DynamicResource ParamSettings_button_set_clicktoget}" 
                                    Style="{StaticResource AccentSettingButtonStyle}"  Cursor="Hand" Click="btnGet_Click" />
                <Button x:Name="btnSet" VerticalAlignment="Center"  Grid.Column="3" Margin="0,0, 20, 0"                                   
                                    HorizontalAlignment="Right"
                                    Content="{DynamicResource ParamSettings_button_set}"                                    
                                    ToolTip="{DynamicResource ParamSettings_button_set_clicktoset}" 
                                    Style="{StaticResource AccentSettingButtonStyle}" Click="btnSet_Click"  />
                <Button x:Name="btnClear" VerticalAlignment="Center"  Grid.Column="4" Margin="0,0, 20, 0"                                   
                                    HorizontalAlignment="Right"
                                    Click="btnClear_Click"
                                    Content="{DynamicResource ActiveMode_BtnClear}"                                    
                                    ToolTip="{DynamicResource ParamSettings_button_set_clicktoClear}" 
                                    Style="{StaticResource AccentSettingButtonStyle}"  />
                <Button  VerticalAlignment="Center"  Grid.Column="5" Margin="0,0, 20, 0"                                   
                                    HorizontalAlignment="Right"
                                    Click="btnswitchover_Click"
                                    Content="{DynamicResource ActiveMode_BtnSwitchover}"                                    
                                    ToolTip="{DynamicResource ParamSettings_button_set_clicktoChange}" 
                                    Style="{StaticResource AccentSettingButtonStyle}"  />
            </Grid>
            <Border Grid.Row="1" Grid.Column="1" Margin="0, 5,0,0"  Style="{StaticResource paramBorderStyle}" >
            </Border>

            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="100*"/>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="60*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" MinHeight="23"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource ActiveMode_WorkState}" FontSize="13"/>
                <TextBlock  Grid.Column="1" Margin="25, 0,0,0" VerticalAlignment="Center" 
                           Text="{Binding workPattern}" FontSize="13"/>

                <ComboBox Visibility="Hidden" Style="{StaticResource paramComboBoxStyle}"  Grid.Column="2"
                      ItemsSource="{DynamicResource ActiveMode_CommunicationProtocol}"
                      SelectedIndex="{Binding TcpOrHttpOrMqtt}"
                      materialDesign:HintAssist.Hint="{DynamicResource Msg_PlsSelect}" Grid.ColumnSpan="2" Margin="0,0,0,0" SelectionChanged="ComboBox_SelectionChanged_1">
                </ComboBox>
            </Grid>
            
            <Border Grid.Row="3" Grid.Column="1" Margin="0, 5,0,0"  Style="{StaticResource paramBorderStyle}" >
            </Border>

            <Label Grid.Row="4" Grid.Column="1"  Content="{DynamicResource ActiveMode_EssentialParam}" 
               Style="{StaticResource paramLabelStyle}">
            </Label>

            <Grid Grid.Row="5" Grid.Column="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="140*"/>
                    <ColumnDefinition Width="70*" />
                    <ColumnDefinition Width="70*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource ActiveMode_DataCycle}" FontSize="13"/>
                <TextBox Grid.Column="1" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Data_aggr.Timeval}"
                         materialDesign:HintAssist.Hint="{DynamicResource ActiveMode_DataCycle_Describe}" />
                <ComboBox  Style="{StaticResource paramComboBoxStyle}"  Grid.Column="2"
                      ItemsSource="{DynamicResource ActiveMode_HardwareInterface_Type}"
                      SelectedIndex="{Binding Upload.Hw_inf}"
                      materialDesign:HintAssist.Hint="{DynamicResource ActiveMode_HardwareInterface}" Grid.ColumnSpan="2" Margin="0,0,0,0" SelectionChanged="ComboBox_SelectionChanged"/>
                <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="3"
                      ItemsSource="{DynamicResource ActiveMode_CommunicationProtocol}"
                      SelectedIndex="{Binding TcpOrHttpOrMqtt}"
                      materialDesign:HintAssist.Hint="{DynamicResource Msg_PlsSelect}" Grid.ColumnSpan="2" Margin="0,0,0,0" SelectionChanged="ComboBox_SelectionChanged_1">
                    <ComboBox.Visibility>
                        <Binding  Path="IsTcpOrHttpOrMqtt" Converter="{StaticResource BooleanToVisibilityConverter}" />
                    </ComboBox.Visibility>
                </ComboBox>
            </Grid>
            <Border Grid.Row="6" Grid.Column="1" Margin="0, 5,0,0" Style="{StaticResource paramBorderStyle}"   />
            <Label Grid.Row="7" Grid.Column="1"  Content="{DynamicResource Mqtt_Arguments}" 
               Style="{StaticResource paramLabelStyle}">
                <Label.Visibility>
                    <Binding Path="IsMqtt" Converter="{StaticResource BooleanToVisibilityConverter}" />
                </Label.Visibility>
            </Label>
            <Grid Grid.Row="8" Grid.Column="1" Margin="0, 0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Visibility>
                    <Binding  Path="IsMqtt" Converter="{StaticResource BooleanToVisibilityConverter}" />
                </Grid.Visibility>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="140*"/>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="140*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_HostAddress}" FontSize="13"/>
                <TextBox Grid.Column="1" Grid.Row="0" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Mqtt.Host}"
                         materialDesign:HintAssist.Hint="{DynamicResource Mqtt_PleaseEnter48}" />
                <TextBlock Grid.Column="2" Grid.Row="0"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_PortNumber}" FontSize="13"/>
                <TextBox Grid.Column="3" Grid.Row="0" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Mqtt.Port}"
                         materialDesign:HintAssist.Hint="{DynamicResource Msg_PlsInput}" Cursor="" />

                <TextBlock Grid.Column="0" Grid.Row="1"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_PublishTopic}" FontSize="13"/>
                <TextBox Grid.Column="1" Grid.Row="1" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Mqtt.Pub_topic}"
                         materialDesign:HintAssist.Hint="{DynamicResource Mqtt_PleaseEnter48}" />
                <TextBlock Grid.Column="2" Grid.Row="1"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_PublishQoS}" FontSize="13"/>
                <ComboBox Grid.Column="3" Grid.Row="1"  Style="{StaticResource paramComboBoxStyle}"
                      ItemsSource="{DynamicResource Mqtt_QoSType}"
                      SelectedIndex="{Binding Upload.Mqtt.Pub_qos}"
                      materialDesign:HintAssist.Hint="{DynamicResource Mqtt_QoS}" Margin="20,0,0,0"/>

                <TextBlock Grid.Column="0" Grid.Row="2"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_SubscribeTopic}" FontSize="13"/>
                <TextBox Grid.Column="1" Grid.Row="2" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Mqtt.Sub_b_topic}"
                         materialDesign:HintAssist.Hint="{DynamicResource Mqtt_PleaseEnter48Null}" />
                <TextBlock Grid.Column="2" Grid.Row="2"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_BroadcastQoS}" FontSize="13"/>
                <ComboBox Grid.Column="3" Grid.Row="2"  Style="{StaticResource paramComboBoxStyle}"
                      ItemsSource="{DynamicResource Mqtt_QoSType}"
                      SelectedIndex="{Binding Upload.Mqtt.Sub_b_qos}"
                      materialDesign:HintAssist.Hint="{DynamicResource Mqtt_QoS}" Margin="20,0,0,0"/>

                <TextBlock Grid.Column="0" Grid.Row="3"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_UnicastSubscribeTopic}" FontSize="13"/>
                <TextBox Grid.Column="1" Grid.Row="3" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Mqtt.Sub_u_topic}"
                         materialDesign:HintAssist.Hint="{DynamicResource Mqtt_PleaseEnter48Null}" />
                <TextBlock Grid.Column="2" Grid.Row="3"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_UnicastSubscribeQoS}" FontSize="13"/>
                <ComboBox Grid.Column="3" Grid.Row="3"  Style="{StaticResource paramComboBoxStyle}"
                      ItemsSource="{DynamicResource Mqtt_QoSType}"
                      SelectedIndex="{Binding Upload.Mqtt.Sub_u_topic}"
                      materialDesign:HintAssist.Hint="{DynamicResource Mqtt_QoS}" Margin="20,0,0,0"/>

                <TextBlock Grid.Column="0" Grid.Row="4"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_Username}" FontSize="13"/>
                <TextBox Grid.Column="1" Grid.Row="4" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Mqtt.User}"
                         materialDesign:HintAssist.Hint="{DynamicResource Mqtt_PleaseEnter32Null}" />
                <TextBlock Grid.Column="2" Grid.Row="4"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_Password}" FontSize="13"/>
                <TextBox Grid.Column="3" Grid.Row="4" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Mqtt.Pwd}"
                         materialDesign:HintAssist.Hint="{DynamicResource Mqtt_PleaseEnter32Null}" />

                <TextBlock Grid.Column="0" Grid.Row="5"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_KeepaliveTime}" FontSize="13"/>
                <TextBox Grid.Column="1" Grid.Row="5" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Mqtt.Kal_time}"
                         materialDesign:HintAssist.Hint="{DynamicResource Mqtt_PleaseEnterKeepaliveTime}" />
                <TextBlock Grid.Column="2" Grid.Row="5"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Mqtt_EnableTLS}" FontSize="13"/>
                <TextBox Grid.Column="3" Grid.Row="5" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Name}"
                         materialDesign:HintAssist.Hint="{DynamicResource ActiveMode_DataCycle_Describe}" />

            </Grid>
            <Label Grid.Row="9" Grid.Column="1"  Content="{DynamicResource Tcp_Arguments}" 
               Style="{StaticResource paramLabelStyle}">
                <Label.Visibility>
                    <Binding Path="IsTcp" Converter="{StaticResource BooleanToVisibilityConverter}" />
                </Label.Visibility>
            </Label>
            <Grid Grid.Row="10" Grid.Column="1" Margin="0, 0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="140*"/>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="140*" />
                </Grid.ColumnDefinitions>
                <Grid.Visibility>
                    <Binding  Path="IsTcp" Converter="{StaticResource BooleanToVisibilityConverter}" />
                </Grid.Visibility>
                <TextBlock Grid.Column="0"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Tcp_HostAddress}" FontSize="13"/>
                <TextBox Grid.Column="1" Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Tcp.Ser_ip}"
                         materialDesign:HintAssist.Hint="{DynamicResource Msg_PlsInput}" />
                <TextBlock Grid.Column="2"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Tcp_PortNumber}" FontSize="13"/>
                <!--Text="{Binding Upload.Tcp.Ser_port}"-->
                <TextBox Grid.Column="3" Style ="{StaticResource paramTextBoxStyle}" 
                         materialDesign:HintAssist.Hint="{DynamicResource Msg_PlsInput}" >
                    <TextBox.Text>
                        <Binding Path="Upload.Tcp.Ser_port" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:RangeValidationRule MinValue="1001" MaxValue="65535" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </Grid>
            <Label Grid.Row="11" Grid.Column="1"  Content="{DynamicResource Http_Arguments}" 
               Style="{StaticResource paramLabelStyle}">
                <Label.Visibility>
                    <Binding Path="IsHttp" Converter="{StaticResource BooleanToVisibilityConverter}" />
                </Label.Visibility>
            </Label>
            <Grid Grid.Row="12" Grid.Column="1" Margin="0, 0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="140*"/>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="140*" />
                </Grid.ColumnDefinitions>
                <Grid.Visibility>
                    <Binding  Path="IsHttp" Converter="{StaticResource BooleanToVisibilityConverter}" />
                </Grid.Visibility>
                <TextBlock Grid.Column="0"   Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Http_Url}" FontSize="13"/>
                <TextBox Grid.Column="1" Grid.ColumnSpan="2"  Style ="{StaticResource paramTextBoxStyle}" Text="{Binding Upload.Http.Url}"
                         materialDesign:HintAssist.Hint="{DynamicResource Msg_PlsInput}" />
            </Grid>
            <Label Grid.Row="13" Grid.Column="1"  Content="{DynamicResource Wiegand_Arguments}" 
               Style="{StaticResource paramLabelStyle}">
                <Label.Visibility>
                    <Binding Path="IsWiegand" Converter="{StaticResource BooleanToVisibilityConverter}" />
                </Label.Visibility>
            </Label>
            <Grid Grid.Row="14" Grid.Column="1" Margin="0, 0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="140*"/>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="140*" />
                </Grid.ColumnDefinitions>
                <Grid.Visibility>
                    <Binding  Path="IsWiegand" Converter="{StaticResource BooleanToVisibilityConverter}" />
                </Grid.Visibility>
                <TextBlock Grid.Column="0" Grid.Row="0"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Wiegand_Interface}" FontSize="13"/>
                <ComboBox Grid.Column="1" Grid.Row="0"  Style="{StaticResource paramComboBoxStyle}"
                      ItemsSource="{DynamicResource Wiegand_InterfaceType}"
                      SelectedIndex="{Binding Upload.Wiegand.Type}"
                      materialDesign:HintAssist.Hint="{DynamicResource Msg_PlsSelect}" Margin="20,0,0,0"/>
                <TextBlock Grid.Column="2" Grid.Row="0"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Wiegand_OutputFormat}" FontSize="13"/>
                <ComboBox Grid.Column="3" Grid.Row="0"  Style="{StaticResource paramComboBoxStyle}"
                      ItemsSource="{DynamicResource Wiegand_OutputFormatType}"
                      SelectedIndex="{Binding Upload.Wiegand.Bytes_order}"
                      materialDesign:HintAssist.Hint="{DynamicResource Msg_PlsSelect}" Margin="20,0,0,0"/>
                <TextBlock Grid.Column="0" Grid.Row="1"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Wiegand_PulseWidth}" FontSize="13"/>
                <TextBox x:Name="Pls_width" Grid.Column="1" Grid.Row="1" Style ="{StaticResource paramTextBoxStyle}"
                         materialDesign:HintAssist.Hint="{DynamicResource Wiegand_PleaseEnterPulseWidth}" >
                    <TextBox.Text>
                        <Binding Path="Upload.Wiegand.Pls_width" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:RangeValidationRule MinValue="4" MaxValue="20" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                
                <TextBlock Grid.Column="2" Grid.Row="1"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Wiegand_PulseInterval}" FontSize="13"/>
                <TextBox x:Name="Pls_interval" Grid.Column="3" Grid.Row="1" Style ="{StaticResource paramTextBoxStyle}"
                         materialDesign:HintAssist.Hint="{DynamicResource Wiegand_PleaseEnterPulseInterval}"  >
                    <TextBox.Text>
                        <Binding  Path="Upload.Wiegand.Pls_interval" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:RangeValidationRule MinValue="8" MaxValue="200" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <TextBlock Grid.Column="0" Grid.Row="2"  Margin="15, 0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource Wiegand_DataOutputInterval}" FontSize="13"/>
                <TextBox Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Style ="{StaticResource paramTextBoxStyle}"  Text="{Binding Upload.Wiegand.Data_interval}"
                         materialDesign:HintAssist.Hint="{DynamicResource Wiegand_PleaseEnterDataOutputInterval}" />
            </Grid>
            <Border Grid.Row="15" Grid.Column="1" Style="{StaticResource paramBorderStyle}"   />
            <Expander Grid.Row="16" Grid.Column="1" Margin="0,20,0,0" Header="{DynamicResource Advanced_Parameters}">
                <StackPanel Margin="10">
                    <mah:ToggleSwitch x:Name="twAddData"   Grid.Row="15"  Grid.Column="1" IsOn="{Binding IsGpi_trigger}"
                              Style="{StaticResource paramToggleSwitchStyle}"
                              OffContent="{DynamicResource GPI_TouchOff}" 
                              OnContent="{DynamicResource GPI_TouchOff}" />
                    <Grid Grid.Row="16" Grid.Column="1" IsEnabled="{Binding ElementName=twAddData,Path=IsOn}" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18*" />
                            <ColumnDefinition Width="167*"/>
                            <ColumnDefinition Width="185*" />
                            <ColumnDefinition Width="185*" />
                            <ColumnDefinition Width="185*" />

                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"  Margin="14,0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource GPI_GPIStatus1}" FontSize="13" Grid.ColumnSpan="2"/>
                        <TextBlock Grid.Column="2"  Margin="15,0,0,0" VerticalAlignment="Center"
                    Text="GPI1" FontSize="13"/>
                        <ToggleButton x:Name="GpiToggleButton1" Width="40" Height="40"  Grid.Column="3" Margin="70,5,0,5"
                          IsChecked="{Binding Path=Gpi_trigger.Cond_1, Mode=OneWay, Converter={StaticResource ArrayContainsValueConverter}, ConverterParameter=GpiToggleButton_1}"
                          Style="{StaticResource gpoTbStateStyle}"
                          ToolTip="{DynamicResource PeripheralView_ClickToChangeState}"                             
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"
                          materialDesign:ToggleButtonAssist.OnContent="{DynamicResource PeripheralView_GPIOstate_High}" />
                        <CheckBox  Style="{StaticResource paramCheckBoxStyle}" x:Name="GpiCheckBox1"
                       IsChecked="{Binding Path=Gpi_trigger.Cond_1, Mode=OneWay, Converter={StaticResource ArrayContainsValueConverter}, ConverterParameter=GpiCheckBox_1}"
                       Grid.Column="4" Margin="50,0,0,0" Content="{DynamicResource Msg_StartUsing}" />

                        <TextBlock Grid.Column="2" Grid.Row="1"  Margin="15,0,0,0" VerticalAlignment="Center"
                    Text="GPI2" FontSize="13"/>
                        <ToggleButton x:Name="GpiToggleButton2" Width="40" Height="40"  Grid.Column="3" Grid.Row="1" Margin="70,5,0,5"
                          IsChecked="{Binding Path=Gpi_trigger.Cond_1, Mode=OneWay, Converter={StaticResource ArrayContainsValueConverter}, ConverterParameter=GpiToggleButton_2}"
                          Style="{StaticResource gpoTbStateStyle}"
                          ToolTip="{DynamicResource PeripheralView_ClickToChangeState}"                             
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"       
                          materialDesign:ToggleButtonAssist.OnContent="{DynamicResource PeripheralView_GPIOstate_High}" />
                        <CheckBox  Style="{StaticResource paramCheckBoxStyle}" x:Name="GpiCheckBox2"
                       IsChecked="{Binding Path=Gpi_trigger.Cond_1, Mode=OneWay, Converter={StaticResource ArrayContainsValueConverter}, ConverterParameter=GpiCheckBox_2}"
                       Grid.Column="4" Grid.Row="1" Margin="50,0,0,0" Content="{DynamicResource Msg_StartUsing}" />
                        <Border Grid.Row="2" Grid.Column="0" Margin="15, 5,15,0" Grid.ColumnSpan="5"  Style="{StaticResource paramBorderStyle}" >
                        </Border>
                        <TextBlock Grid.Column="0" Grid.Row="3" Grid.RowSpan="2"  Margin="15,0,0,0" VerticalAlignment="Center"
                    Text="{DynamicResource GPI_GPIStatus2}" FontSize="13" Grid.ColumnSpan="2"/>
                        <TextBlock Grid.Column="2" Grid.Row="3"  Margin="15,0,0,0" VerticalAlignment="Center"
                    Text="GPI1" FontSize="13"/>
                        <ToggleButton x:Name="GpiToggleButton3" Width="40" Height="40"  Grid.Column="3" Grid.Row="3" Margin="70,5,0,5"
                          IsChecked="{Binding Path=Gpi_trigger.Cond_2, Mode=OneWay, Converter={StaticResource ArrayContainsValueConverter}, ConverterParameter=GpiToggleButton_1}"
                          Style="{StaticResource gpoTbStateStyle}"
                          ToolTip="{DynamicResource PeripheralView_ClickToChangeState}"                             
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"       
                          materialDesign:ToggleButtonAssist.OnContent="{DynamicResource PeripheralView_GPIOstate_High}" />
                        <CheckBox  Style="{StaticResource paramCheckBoxStyle}"  x:Name="GpiCheckBox3"
                       IsChecked="{Binding Path=Gpi_trigger.Cond_2, Mode=OneWay, Converter={StaticResource ArrayContainsValueConverter}, ConverterParameter=GpiCheckBox_1}"
                       Grid.Column="4" Grid.Row="3" Margin="50,0,0,0" Content="{DynamicResource Msg_StartUsing}" />

                        <TextBlock Grid.Column="2" Grid.Row="4"  Margin="15,0,0,0" VerticalAlignment="Center"
                    Text="GPI2" FontSize="13"/>
                        <ToggleButton x:Name="GpiToggleButton4" Width="40" Height="40"  Grid.Column="3" Grid.Row="4" Margin="70,5,0,5"
                          IsChecked="{Binding Path=Gpi_trigger.Cond_2, Mode=OneWay, Converter={StaticResource ArrayContainsValueConverter}, ConverterParameter=GpiToggleButton_2}"
                          Style="{StaticResource gpoTbStateStyle}"
                          ToolTip="{DynamicResource PeripheralView_ClickToChangeState}"                             
                          Content="{DynamicResource PeripheralView_GPIOstate_Low}"       
                          materialDesign:ToggleButtonAssist.OnContent="{DynamicResource PeripheralView_GPIOstate_High}" />
                        <CheckBox  Style="{StaticResource paramCheckBoxStyle}" x:Name="GpiCheckBox4"
                       IsChecked="{Binding Path=Gpi_trigger.Cond_2, Mode=OneWay, Converter={StaticResource ArrayContainsValueConverter}, ConverterParameter=GpiCheckBox_2}"
                       Grid.Column="4" Grid.Row="4" Margin="50,0,0,0" Content="{DynamicResource Msg_StartUsing}" />
                        <Border Grid.Row="5" Grid.Column="0" Margin="15, 5,15,0" Grid.ColumnSpan="5"  Style="{StaticResource paramBorderStyle}" >
                        </Border>
                        <TextBlock Grid.Column="0" Grid.Row="6"  Margin="15,0,0,0" VerticalAlignment="Center"
