<UserControl x:Class="ReaderManager.FirmwareUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             Loaded="UserControl_Loaded" SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>

        <Style   BasedOn="{StaticResource MahApps.Styles.Label}"   x:Key="fwUpdProgLabel"
               TargetType="Label"  >
            <Setter Property="Foreground" Value="#FF0E3193" />
            <Setter Property="FontSize" Value="15" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">

        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="23*" />
                <ColumnDefinition Width="3*" MinWidth="60"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"  Grid.Column="1" 
                    BorderThickness="0,0,0,2" BorderBrush="#100E3193">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="{DynamicResource FirmwareUpdateView_FwVersion}" Grid.Column="0"
                       FontSize="19" Foreground="{StaticResource MahApps.Brushes.AccentBase}"
                       VerticalAlignment="Center"
                       BorderBrush="{DynamicResource MahApps.Colors.Accent1}" />
                        <Label Content="{Binding UpdFwVersion}" Grid.Column="1"
                       FontSize="19" Foreground="{StaticResource MahApps.Brushes.AccentBase}"
                       VerticalAlignment="Center"
                       BorderBrush="{DynamicResource MahApps.Colors.Accent1}" />
                
              
                    <Button VerticalAlignment="Center"  Grid.Column="2" Margin="0,0, 100, 0"   
                            IsEnabled="{Binding Path=IsUpdFw, Converter={StaticResource MyBoolConvert}}"
                                    HorizontalAlignment="Right"
                                    x:Name="btnGet" Click="btnGet_Click"
                                    Content="{DynamicResource ParamSettings_button_get}"                                    
                                    ToolTip="{DynamicResource FirmwareUpdateView_btnGetTip}" 
                                    Style="{StaticResource AccentSettingButtonStyle}" />

                    <Button VerticalAlignment="Center"  Grid.Column="2" x:Name="btnUpdate"
                            IsEnabled="{Binding Path=IsUpdFw, Converter={StaticResource MyBoolConvert}}"
                                    HorizontalAlignment="Right" Click="btnUpdate_Click"
                                    Content="{DynamicResource FirmwareUpdateView_btnUpdate}"                                                                    
                                    ToolTip="{DynamicResource FirmwareUpdateView_btnUpdateTip}"
                                    Style="{StaticResource AccentSettingButtonStyle}" />

                </Grid>
            </Border>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" x:Name="gdMain">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="907*"/>
                    <ColumnDefinition Width="158*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" MinHeight="30"/>
                    <RowDefinition Height="26" MinHeight="26"/>
                    <RowDefinition Height="60" MinHeight="60"/>
                    <RowDefinition Height="10" MinHeight="10"/>
                    <RowDefinition Height="26" MinHeight="26"/>
                    <RowDefinition Height="40" MinHeight="40"/>
                    <RowDefinition Height="20" MinHeight="20"/>
                    <RowDefinition Height="30" MinHeight="30"/>
                    <RowDefinition Height="48" MinHeight="48"/>
                    <RowDefinition Height="20" MinHeight="20"/>
                    <RowDefinition Height="30" MinHeight="30"/>
                    <RowDefinition Height="40" MinHeight="40"/>

                </Grid.RowDefinitions>
                <Label Content="{DynamicResource FirmwareUpdateView_UpdateGuide}" 
                       Style="{StaticResource paramLabelStyle}" />
                <TextBlock Text="{DynamicResource FirmwareUpdateView_Tip_UpdateFw}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.AccentBase}" Margin="20,0,0,0"
                       Grid.Row="1"  FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="tbTip1"  Text="{DynamicResource FirmwareUpdateView_Tip_UpdateFwDetails}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.AccentBase}" Margin="20,0,0,0"
                       Grid.Row="2"  MinWidth="560"  FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.ColumnSpan="2"/>

                <TextBlock Text="{DynamicResource FirmwareUpdateView_Tip_GetVer}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.AccentBase}" Margin="20,0,0,0"
                       Grid.Row="4" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="tbTip2"  Text="{DynamicResource FirmwareUpdateView_Tip_GetVerDetails}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.AccentBase}" Margin="20,0,0,0"
                       Grid.Row="5"  MinWidth="560"  FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                <Border  Style="{StaticResource paramBorderStyle}" Grid.Row="6" Grid.ColumnSpan="2" />

                <Label Content="{DynamicResource FirmwareUpdateView_UpdateParams}" 
                       Grid.Row="7" Style="{StaticResource paramLabelStyle}" />
                <Grid Grid.Row="8" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style ="{StaticResource paramTextBoxStyle}" 
                             Grid.Column="0"  Text="{Binding UpdFwReaderAddr}"
                         materialDesign:HintAssist.Hint="{DynamicResource FirmwareUpdateView_Parmas_RdAddr}" />
                    <TextBox Style ="{StaticResource paramTextBoxStyle}"  MaxWidth="300"
                             Grid.Column="1" Text="{Binding UpdFwFilePath}"
                         materialDesign:HintAssist.Hint="{DynamicResource FirmwareUpdateView_Parmas_FwFile}" />
                    <Button  VerticalAlignment="Center"  Grid.Column="2" Margin="20,15, 0, 0"                                   
                                    HorizontalAlignment="Left" Height="25" 
                                    IsEnabled="{Binding Path=IsUpdFw, Converter={StaticResource MyBoolConvert}}"
                                 x:Name="btnBrowse" Click="btnBrowse_Click"
                                    Content="{DynamicResource FirmwareUpdateView_btnBrowse}"                                    
                                    ToolTip="{DynamicResource FirmwareUpdateView_btnBrowse_tip}" 
                                    Style="{StaticResource AccentSettingButtonStyle}" />
                </Grid>
                <Border  Style="{StaticResource paramBorderStyle}"  Grid.Row="9" Grid.ColumnSpan="2" />

                <WrapPanel Grid.Row="10" Grid.ColumnSpan="2" >
                    <Label Content="{DynamicResource FirmwareUpdateView_Progress}" 
                           Style="{StaticResource fwUpdProgLabel}" />
                    <Label Content="{Binding UpdFwPercent}"  Style="{StaticResource fwUpdProgLabel}" Margin="10,0,0,0"/>
                </WrapPanel>

                <ProgressBar x:Name="pbFwUpdProg"    Grid.Row="11" Height="15" Background="Transparent"
                             Value="{Binding UpFwProgress}" MinWidth="560"
                             HorizontalAlignment="Left" Margin="20,12,0,12"/>
            </Grid>
        </Grid>
    </ScrollViewer>

</UserControl>
