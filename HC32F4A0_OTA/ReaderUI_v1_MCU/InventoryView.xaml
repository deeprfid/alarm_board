<UserControl x:Class="ReaderManager.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             d:DesignHeight="300"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged"
             IsEnabled="{Binding IsConnect}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="{x:Type ListViewItem}" x:Key="myListViewItem"
               BasedOn="{StaticResource MaterialDesignGridViewItem}">

            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsSelected" Value="false" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                </MultiTrigger>

            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type GridViewColumnHeader}"    
      
               x:Key="MyMouseOnHeader" >
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentCircleButtonStyle"
                BasedOn="{StaticResource MahApps.Styles.Button.Circle}"
                TargetType="{x:Type ButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"   BorderThickness="0,0,0,2" BorderBrush="#100E3193">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!--<ColumnDefinition Width="1*" />-->
                        <ColumnDefinition Width="26*" />
                        <!--<ColumnDefinition Width="1*" />-->
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="29*"/>
                            <RowDefinition Height="9*"/>
                            <RowDefinition Height="20*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120*" />
                            <ColumnDefinition Width="146*" />
                            <ColumnDefinition Width="140*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="80*" />
                        </Grid.ColumnDefinitions>

                        <!--<Label Content="{DynamicResource HamburgerMenu_inventory}"   Grid.Column="0"
                   FontSize="19" Foreground="{StaticResource MahApps.Brushes.AccentBase}"
                   VerticalAlignment="Center"
                   BorderBrush="{DynamicResource MahApps.Colors.Accent1}" Height="34" Margin="0,12" />-->
                        <!--
                                <lvc:CartesianChart Grid.Row="0" x:Name="ccInvSpeed"
                                     Grid.Column="5" Margin="0,0,10,0" >
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis  ShowLabels="False"></lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis  MinValue="0" MaxValue="400"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                   -->

                        <materialDesign:PackIcon Kind="Label" Grid.Column="0" Width="25" Height="26"
                                                 Foreground="{StaticResource MahApps.Brushes.Accent2}"
                                                 Margin="0,16,0,0" Grid.RowSpan="3"
                                                 ToolTip="{DynamicResource Inventory_listview_colum_tabamount}"/>

                        <Label x:Name="tbTagCount" Grid.Column="0" FontSize="38" HorizontalAlignment="Left" Margin="27,0,0,0"
                                   VerticalAlignment="Top"  Content="{Binding Items.Count, ElementName=dgTags}"
                                   ToolTip="{DynamicResource Inventory_listview_colum_tabamount}"
                                   Foreground="{StaticResource MahApps.Brushes.AccentBase}" Height="58" Width="148" Grid.RowSpan="3"/>

                        <materialDesign:PackIcon Kind="ChartBar" Grid.Column="1" Width="25" Height="26"
                                                 Foreground="{StaticResource MahApps.Brushes.Accent2}" Margin="0,16,0,0" Grid.RowSpan="3"
                                                 ToolTip="{DynamicResource Inventory_listview_colum_tabcount}"/>
                        <Label x:Name="tbTagReadCount" Grid.Column="1" FontSize="38" HorizontalAlignment="Left" Margin="27,0,0,0"
                                   VerticalAlignment="Top" Content="{Binding listTagsReadCount}" ToolTip="{DynamicResource Inventory_listview_colum_tabcount}"
                                   Foreground="{StaticResource MahApps.Brushes.AccentBase}" Height="58" Width="127" Grid.RowSpan="3"/>

                        <materialDesign:PackIcon Kind="Timer" Grid.Column="2" Width="25" Height="26"
                                                 Foreground="{StaticResource MahApps.Brushes.Accent2}"
                                                 Margin="1,16,0,0" Grid.RowSpan="3"
                                                  ToolTip="{DynamicResource Inventory_listview_colum_tabtime}"/>

                        <Label x:Name="tbTagTime" Grid.Column="2" FontSize="38" HorizontalAlignment="Left" Margin="27,0,0,0"
                                   VerticalAlignment="Top" Content="{Binding workTime}"
                                   ToolTip="{DynamicResource Inventory_listview_colum_tabtime}"
                                   Foreground="{StaticResource MahApps.Brushes.AccentBase}" Height="58" Width="148" Grid.RowSpan="3">
                        </Label>

                        <Button  x:Name="btnStart" Width="40" Height="40"
                          Style="{StaticResource MaterialDesignIconButton}"  Grid.Column="3"   
                          ToolTip="{DynamicResource Inventory_listview_colum_StartInventory}"
                          VerticalAlignment="Top"
                          Click="btnStart_Click"
                          IsEnabled="{Binding Path=IsInventory, Converter={StaticResource MyBoolConvert}}"
                          HorizontalAlignment="Center"
                          Foreground="Green"
                          Background="{DynamicResource MaterialDesignTextFieldBoxBackground}" Margin="0,9,0,0" Grid.RowSpan="3">
                            <materialDesign:PackIcon Height="28" Width="28" Kind="Play" />
                        </Button>
                        <Button x:Name="btnStop" Width="40" VerticalAlignment="Top"  Grid.Column="4"
                                    Click="btnStop_Click"
                                IsEnabled="{Binding Path=IsInventory}"
                                    Height="40"
                                Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    HorizontalAlignment="Left"
                                    Foreground="Red"
                                    ToolTip="{DynamicResource Inventory_listview_colum_StopInventory}"
                                    Style="{StaticResource MaterialDesignIconButton}" Margin="3,9,0,0" Grid.RowSpan="3">
                            <materialDesign:PackIcon  Kind="Stop" 
                                            Height="28"
                                            Width="28" />
                        </Button>
                        <Button x:Name="btnClear" Width="40" VerticalAlignment="Top" Grid.Column="5"
                                    Click="btnClear_Click"
                                    Height="40"
                                    IsEnabled="{Binding Path=IsInventory, Converter={StaticResource MyBoolConvert}}"
                                    Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    HorizontalAlignment="Center"
                                    ToolTip="{DynamicResource Inventory_listview_colum_ClearData}"
                                    Style="{StaticResource MaterialDesignIconButton}" Margin="0,9,0,0" Grid.RowSpan="3" >
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" />
                        </Button>
                        <Button x:Name="btnExport" Width="40" VerticalAlignment="Top" Grid.Column="6"
                                    Click="btnExport_Click"
                                    Height="40"
                                    Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    HorizontalAlignment="Left"
                                    ToolTip="{DynamicResource Inventory_listview_colum_ExportData}"
                                    Style="{StaticResource MaterialDesignIconButton}" Margin="0,9,0,0" Grid.RowSpan="3">
                            <materialDesign:PackIcon Kind="FileExport" Width="20" Height="20" />
                        </Button>

                    </Grid>
                </Grid>
            </Border>

            <ListView Grid.Row="1"  x:Name="dgTags" Style="{StaticResource MaterialDesignListView}"
                      ItemContainerStyle="{StaticResource myListViewItem}"
                     
                  FontSize="12.3"  GridViewColumnHeader.Click="Sort_Click" 
                  Margin="35,0,0,0"
                  MinWidth="770"     
                  materialDesign:ListViewAssist.ListViewItemPadding="0,4.5,0,4.5"
                  VirtualizingStackPanel.IsVirtualizing ="true"
                  VirtualizingStackPanel.VirtualizationMode ="Recycling" MouseDoubleClick="DgTags_MouseDoubleClick" >
                <ListView.View >

                    <GridView x:Name="gvTags" >
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_epc}" Width="261.408" DisplayMemberBinding="{Binding Epc}" />
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_readcount}" Width="66.13" DisplayMemberBinding="{Binding Reads}"/>
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_ant}" Width="50.57" DisplayMemberBinding="{Binding Ant}"/>
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_bankdata}"  Width="165.714" DisplayMemberBinding="{Binding BankData}"/>
                        <GridViewColumn Header="{DynamicResource Inventory_listview_colum_prot}" Width="59.128" DisplayMemberBinding="{Binding Prot}"/>
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_rssi}" Width="52.126" DisplayMemberBinding="{Binding Rssi}"/>
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_freq}" Width="62.24" DisplayMemberBinding="{Binding Freq}"/>
                        <GridViewColumn  Header="{DynamicResource Inventory_listview_colum_phase}" Width="60.684" DisplayMemberBinding="{Binding Phase}"/>
                    </GridView>

                </ListView.View>


            </ListView>
        </Grid >
    </ScrollViewer>
</UserControl>