<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ReaderManager.OtaUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="760">

    <UserControl.Resources>
        <!-- 输入框：灰色实线下划线 2px；Margin 与下拉框一致 → 下划线左对齐 -->
        <Style x:Key="otaUnderlineTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF9E9E9E"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Margin" Value="20,0,20,0"/>
        </Style>
        <Style x:Key="otaFieldLabel" TargetType="Label" BasedOn="{StaticResource paramLabelStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="otaComboStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="20,0,20,0"/>
        </Style>
    </UserControl.Resources>

    <!-- 整体布局：全部内容整体居中（占中间 50%，两侧留空） -->
    <Grid Margin="0,10,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" MinHeight="30"/>
                <RowDefinition Height="48" MinHeight="48"/>
                <RowDefinition Height="20" MinHeight="20"/>
                <RowDefinition Height="48" MinHeight="48"/>
                <RowDefinition Height="20" MinHeight="20"/>
                <RowDefinition Height="48" MinHeight="48"/>
                <RowDefinition Height="20" MinHeight="20"/>
                <RowDefinition Height="48" MinHeight="48"/>
                <RowDefinition Height="20" MinHeight="20"/>
                <RowDefinition Height="48" MinHeight="48"/>
                <RowDefinition Height="26" MinHeight="26"/>
                <RowDefinition Height="*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <!-- 标题 + 版本显示 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{DynamicResource Ota_title}" Style="{StaticResource paramLabelStyle}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Label Content="{DynamicResource Ota_devver}" Style="{StaticResource paramLabelStyle}" FontSize="13" Foreground="#FF5C5C5C"/>
                    <Label x:Name="lblDevVer" Content="--" Style="{StaticResource paramLabelStyle}" FontSize="13" FontWeight="Bold"/>
                    <Label Content="{DynamicResource Ota_pkgver}" Style="{StaticResource paramLabelStyle}" FontSize="13" Foreground="#FF5C5C5C"/>
                    <Label x:Name="lblPkgVer" Content="--" Style="{StaticResource paramLabelStyle}" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- 升级通道 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{DynamicResource Ota_channel}" Style="{StaticResource otaFieldLabel}"/>
                <ComboBox Grid.Column="1" x:Name="cmbChannel" Style="{StaticResource otaComboStyle}"
                          SelectionChanged="CmbChannel_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource Ota_ch_uart}"/>
                    <ComboBoxItem Content="{DynamicResource Ota_ch_usbcdc}"/>
                    <ComboBoxItem Content="{DynamicResource Ota_ch_http}"/>
                    <ComboBoxItem Content="{DynamicResource Ota_ch_usbdisk}"/>
                    <ComboBoxItem Content="{DynamicResource Ota_ch_winusb}"/>   <!-- v1.10: WinUSB 快通道 -->
                </ComboBox>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource paramBorderStyle}"/>

            <!-- 串口/COM + 刷新 + 读版本 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{DynamicResource Ota_comport}" Style="{StaticResource otaFieldLabel}"/>
                <ComboBox Grid.Column="1" x:Name="cmbPort" Style="{StaticResource otaComboStyle}"/>
                <Button Grid.Column="2" Content="{DynamicResource Ota_refresh}" Click="BtnRefresh_Click" VerticalAlignment="Center"
                        Style="{StaticResource AccentSettingButtonStyle}" Width="105" HorizontalAlignment="Right"/>
                <Button Grid.Column="3" Content="{DynamicResource Ota_readver}" Click="BtnReadVer_Click" VerticalAlignment="Center"
                        Style="{StaticResource AccentSettingButtonStyle}" Width="105" HorizontalAlignment="Right"/>
            </Grid>
            <Border Grid.Row="4" Style="{StaticResource paramBorderStyle}"/>

            <!-- 设备 IP -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{DynamicResource Ota_devip}" Style="{StaticResource otaFieldLabel}"/>
                <TextBox Grid.Column="1" x:Name="txtIp" Text="192.168.1.250"
                         Style="{StaticResource otaUnderlineTextBox}" FontSize="15"/>
            </Grid>
            <Border Grid.Row="6" Style="{StaticResource paramBorderStyle}"/>

            <!-- 固件包 + 浏览 -->
            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{DynamicResource Ota_pkgfile}" Style="{StaticResource otaFieldLabel}"/>
                <TextBox Grid.Column="1" x:Name="txtFile" IsReadOnly="True"
                         Style="{StaticResource otaUnderlineTextBox}"
                         ToolTip="{DynamicResource Ota_tip_pkgtooltip}"/>
                <Button Grid.Column="2" Content="{DynamicResource Ota_browse}" Click="BtnBrowse_Click" VerticalAlignment="Center"
                        Style="{StaticResource AccentSettingButtonStyle}" Width="80" HorizontalAlignment="Right"/>
            </Grid>
            <Border Grid.Row="8" Style="{StaticResource paramBorderStyle}"/>

            <!-- 操作：开始升级 / 停止 / 清空日志（左-中-右） -->
            <Grid Grid.Row="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="btnStart" Content="{DynamicResource Ota_start}" Click="BtnStart_Click"
                        Style="{StaticResource AccentSettingButtonStyle}" Width="90" HorizontalAlignment="Left"/>
                <Button Grid.Column="1" x:Name="btnStop" Content="{DynamicResource Ota_stop}" Click="BtnStop_Click"
                        Style="{StaticResource AccentSettingButtonStyle}" IsEnabled="False"
                        HorizontalAlignment="Center"/>
                <Button Grid.Column="2" Content="{DynamicResource Ota_clearlog}" Click="BtnClearLog_Click"
                        Style="{StaticResource AccentSettingButtonStyle}" Width="80" HorizontalAlignment="Right"/>
            </Grid>

            <!-- 进度：占整个左半行 -->
            <Grid Grid.Row="10">
                <mah:MetroProgressBar x:Name="pbProgress" Height="16" VerticalAlignment="Center"
                                      Minimum="0" Maximum="100" Background="Transparent"/>
                <Label x:Name="lblPercent" Content="0%" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource fwUpdProgLabel}" Background="White" Padding="4,0"/>
            </Grid>

            <!-- 日志：占整个左半行 -->
            <TextBox Grid.Row="11" x:Name="txtLog" IsReadOnly="True" Margin="0,8,0,0"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="15" TextWrapping="Wrap"
                     BorderBrush="#100E3193" BorderThickness="1" Padding="6,4"
                     Foreground="#FF333333" Background="#FFF7F9FF"/>
        </Grid>
    </Grid>
</UserControl>
