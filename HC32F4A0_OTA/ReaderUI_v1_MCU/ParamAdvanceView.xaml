<UserControl x:Class="ReaderManager.ParamAdvanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" IsVisibleChanged="UserControl_IsVisibleChanged"
             SizeChanged="UserControl_SizeChanged" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <x:Array x:Key="hopmodeItems" Type="sys:String">
            <sys:String>Mode0</sys:String>
            <sys:String>Mode1</sys:String>
            <sys:String>Mode2</sys:String>
        </x:Array>

        <x:Array x:Key="gen2Targetstrs" Type="sys:String">
            <sys:String>A</sys:String>
            <sys:String>B</sys:String>
            <sys:String>A->B</sys:String>
            <sys:String>B->A</sys:String>
        </x:Array>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0" x:Name="gdMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" MinHeight="30"/>
            <RowDefinition Height="48" MinHeight="48"/>
            <RowDefinition Height="20" MinHeight="20"/>
            <RowDefinition Height="30" MinHeight="30"/>
            <RowDefinition Height="48" MinHeight="48"/>
            <RowDefinition Height="20" MinHeight="20"/>
            <RowDefinition Height="30" MinHeight="30"/>
            <RowDefinition Height="44" MinHeight="44"/>
            <RowDefinition Height="*"  Tag="NoChange"/>

        </Grid.RowDefinitions>

        <Label Content="{DynamicResource ParamSettings_ParamAdvance_gen2potlparams}" 
               Grid.Row="0" Style="{StaticResource paramLabelStyle}"/>
        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="8*"/>
                <ColumnDefinition Width="141*"/>
                <ColumnDefinition Width="160*" />
                <ColumnDefinition Width="160*" />
                <ColumnDefinition Width="160*" />
                <ColumnDefinition Width="160*" />
            </Grid.ColumnDefinitions>
            <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="2"
                      SelectedIndex="{Binding FreqHopMode}" IsEnabled="{Binding EnableFreqHopMode}"
                                  ItemsSource="{StaticResource hopmodeItems}"
                                  materialDesign:HintAssist.Hint="{DynamicResource ParamSettings_ParamInv_hopmode}" HorizontalAlignment="Center"/>
            <TextBox Style ="{StaticResource paramTextBoxStyle}"  Grid.Column="3"
                     Text="{Binding AntMaxDwellTime}"  IsEnabled="{Binding EnableAntMaxDwellTime}"
                         materialDesign:HintAssist.Hint="{DynamicResource ParamSettings_ParamInv_antdwelltime}" Margin="20,0,159,0" Grid.ColumnSpan="2" />
            <!--<ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="0"  
                                SelectedIndex="{Binding Gen2Target}"
                                  ItemsSource="{StaticResource gen2Targetstrs}" 
                                  materialDesign:HintAssist.Hint="Gen2 Target" />
            <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="1"  
                      SelectedIndex="{Binding Gen2QValue}"
                                  ItemsSource="{StaticResource gen2Qstrs}" ToolTip="Gen2 Q Value"
                                  materialDesign:HintAssist.Hint="Gen2 Q Value" />-->

            <ComboBox Style="{StaticResource paramComboBoxStyle}"  SelectedIndex="{Binding Gen2WriteMode}"
                      Grid.Column="4"  x:Name="cbbGen2WriteMode"    
                      ItemsSource="{DynamicResource List_ParamSettings_ParamAdvance_wmode}"
                                  materialDesign:HintAssist.Hint="{DynamicResource ParamSettings_ParamAdvance_gen2writemode}" IsEnabled="False" HorizontalAlignment="Center" />
        </Grid>
        <Border  Style="{StaticResource paramBorderStyle}" Grid.Row="2" />

        <Label Content="{DynamicResource ParamSettings_ParamAdvance_tagdatacache}" 
               Grid.Row="3" Style="{StaticResource paramLabelStyle}"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox  Style="{StaticResource paramCheckBoxStyle}"  IsChecked="{Binding UniByAnt}"
                       Grid.Column="0"  Content="{DynamicResource ParamSettings_ParamAdvance_tdc_ant}" />

            <CheckBox  Style="{StaticResource paramCheckBoxStyle}"  IsChecked="{Binding UniByBankData}"
                       Grid.Column="1"  Content="{DynamicResource ParamSettings_ParamAdvance_tdc_bank}" />

            <CheckBox  Style="{StaticResource paramCheckBoxStyle}"  IsChecked="{Binding RecordHighestRssi}"
                       Grid.Column="2"  Content="{DynamicResource ParamSettings_ParamAdvance_tdc_rssi}" />
        </Grid>

        <Border  Style="{StaticResource paramBorderStyle}" Grid.Row="5" />
        <Label Content="{DynamicResource ParamSettings_ParamAdvance_hoptabandregion}" 
               Grid.Row="6" Style="{StaticResource paramLabelStyle}" />

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Content="{DynamicResource ParamSettings_ParamAdvance_hoptab}" FontSize="14"   Grid.Column="0" VerticalAlignment="Bottom"
                   Margin="20,0,0,0" 
                   Style="{StaticResource paramLabelStyle}" />
            <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="1"  Margin="20,0,20,0" 
                                  x:Name="cbbRegion" VerticalAlignment="Bottom"   SelectedIndex="{Binding Region}" 
                      ItemsSource="{DynamicResource List_ParamSettings_ParamAdvance_region}"
                                  materialDesign:HintAssist.Hint="{DynamicResource ParamSettings_ParamAdvance_region}" />

        </Grid >
        <Border Grid.Row="8" BorderThickness="0,2,0,2" Margin="20,10,0,0" BorderBrush="#100E3193">
            <WrapPanel  x:Name="wpHoptab"  HorizontalAlignment="Left" Width="540" MinWidth="540"
              Margin="0,10,0,0" >

            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
