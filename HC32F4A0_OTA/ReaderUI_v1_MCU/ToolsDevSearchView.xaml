<UserControl x:Class="ReaderManager.ToolsDevSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="DataGrid" BasedOn="{StaticResource MahApps.Styles.DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- 网络接口下拉框专用样式：无 20px 边距挤压，IP 完整居中显示 -->
        <Style x:Key="devSearchComboBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="gdMain" Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" MinHeight="40"/>
            <RowDefinition Height="20" MinHeight="20"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="30" MinHeight="30"/>
        </Grid.RowDefinitions>

        <!-- 工具栏：接口选择 + 按钮 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="{DynamicResource DevSearch_networkinterface}" Grid.Column="0" Style="{StaticResource paramLabelStyle}"/>
            <ComboBox x:Name="cbbIps" Grid.Column="1" Width="180" Height="30"
                      Style="{StaticResource devSearchComboBoxStyle}" 
                      Margin="5,0,10,0"/>
            <Button x:Name="btnSearch" Grid.Column="2" Content="{DynamicResource DevSearch_startsearch}" Height="28" Width="90"
                    Style="{StaticResource AccentSettingButtonStyle}" Click="btnSearch_Click" Margin="5,0"/>
            <Button x:Name="btnStop" Grid.Column="3" Content="{DynamicResource DevSearch_stopsearch}" Height="28" Width="90"
                    Style="{StaticResource AccentSettingButtonStyle}" Click="btnStop_Click" 
                    IsEnabled="False" Margin="5,0"/>
            <Button x:Name="btnClear" Grid.Column="4" Content="{DynamicResource DevSearch_clear}" Height="28" Width="60"
                    Style="{StaticResource AccentSettingButtonStyle}" Click="btnClear_Click" Margin="5,0"/>
            <TextBlock x:Name="txtStatus" Grid.Column="5" VerticalAlignment="Center" 
                       FontSize="13" FontFamily="Microsoft YaHei UI"
                       Foreground="#FF5C5C5C" Margin="20,0,0,0"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource paramBorderStyle}" />

        <!-- 设备列表（列宽 +25%，保证内容完整显示） -->
        <DataGrid Grid.Row="2" x:Name="dgDevices"
                  MouseDoubleClick="dgDevices_MouseDoubleClick"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="colNo" Header="编号" Width="63" MinWidth="50" Binding="{Binding No}"/>
                <DataGridTextColumn x:Name="colIp" Header="IP" Width="163" MinWidth="130" Binding="{Binding Ip}"/>
                <DataGridTextColumn x:Name="colMac" Header="MAC" Width="188" MinWidth="150" Binding="{Binding Mac}"/>
                <DataGridTextColumn x:Name="colBoardType" Header="主板类型" Width="113" MinWidth="90" Binding="{Binding BoardType}"/>
                <DataGridTextColumn x:Name="colModType" Header="模块类型" Width="125" MinWidth="100" Binding="{Binding ModType}"/>
                <DataGridTextColumn x:Name="colBver" Header="主板版本" Width="125" MinWidth="100" Binding="{Binding Bver}"/>
                <DataGridTextColumn x:Name="colMver" Header="模块版本" Width="125" MinWidth="100" Binding="{Binding Mver}"/>
                <DataGridTextColumn x:Name="colWmode" Header="工作模式" Width="100" MinWidth="80" Binding="{Binding Wmode}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="3" Text="{DynamicResource DevSearch_tip_dblclick}" 
                   FontSize="12" FontFamily="Microsoft YaHei UI"
                   Foreground="#FF5C5C5C" 
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
