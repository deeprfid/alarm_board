<mah:MetroWindow x:Class="ReaderManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReaderManager" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 Title="RFID Manager"                 
                 TitleCharacterCasing="Normal"                
                 Width="900"
                 MinWidth="900"
                 Height="560"
                 MinHeight="560"
                 TitleBarHeight="38"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d" Closing="MetroWindow_Closing" Loaded="MetroWindow_Loaded">

    
    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
   
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button ToolTip="{DynamicResource FlyView_Bottom_TagFilter_Title}" 
                    x:Name="btnOpenFlyBottomTf" Click="btnOpenFlyBottomTf_Click">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilterOutline"  Width="24" Height="24"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Margin="4 0 0 0"
                         VerticalAlignment="Center"
                         Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>


            <Button ToolTip="{DynamicResource FlyView_Bottom_Inv_Title}" 
                    x:Name="btnOpenFlyBottomInv" Click="btnOpenFlyBottomInv_Click">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar"  Width="22" Height="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Margin="4 0 0 0"
                         VerticalAlignment="Center"
                         Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>

            <Button x:Name="btnOpenFlyBottomPotl" Click="btnOpenFlyBottomPotl_Click" 
                    ToolTip="{DynamicResource FlyView_Bottom_Potl_Title}" >
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TabSearch"  Width="22" Height="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Margin="4 0 0 0"
                         VerticalAlignment="Center"
                         Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>

            <Button x:Name="btnChangeLang" Click="btnChangeLang_Click" ToolTip="{DynamicResource FlyView_Bottom_LanguageSwitch}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Translate"  Width="22" Height="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Margin="4 0 0 0"
                         VerticalAlignment="Center"
                         Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <mah:Flyout x:Name="flyBottomInv" Header="{DynamicResource FlyView_Bottom_Inv_Title}" 
                        Position="Bottom" Height="200"
                        mah:HeaderedControlHelper.HeaderFontSize="16" 
                        Background="#F9FAFC" Theme="Light">
                <local:FlyBottomInvView />
            </mah:Flyout>
            <mah:Flyout x:Name="flyBottomPotl" Header="{DynamicResource FlyView_Bottom_Potl_Title}" 
                        Position="Bottom" Height="200"
                        mah:HeaderedControlHelper.HeaderFontSize="16" 
                        Background="#F9FAFC" Theme="Light">
                <local:FlyBottomPotlView />
            </mah:Flyout>
            <mah:Flyout x:Name="flyBottomTagFilter" Header="{DynamicResource FlyView_Bottom_TagFilter_Title}" 
                        Position="Bottom" Height="200"
                        mah:HeaderedControlHelper.HeaderFontSize="16" 
                        Background="#F9FAFC" Theme="Light">
                <local:FlyBottomTagFilterView />
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>

   
    <local:HamburgerMenuRipple x:Name="hbMainMenu"></local:HamburgerMenuRipple>

</mah:MetroWindow>
