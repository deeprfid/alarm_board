<UserControl x:Class="ReaderManager.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="520"
             d:DesignWidth="800"
             mc:Ignorable="d">


    <ScrollViewer 
        Focusable="False"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="15*" />
                <RowDefinition Height="2.5*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="23*" />
                <!--<ColumnDefinition Width="2*" />-->
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="1"  BorderThickness="0,0,0,2" BorderBrush="#100E3193">
                <Label Content="{DynamicResource HamburgerMenu_devconnect}"
                   FontSize="19" Foreground="#FF0E3193"
                   VerticalAlignment="Center"
                   BorderBrush="{DynamicResource MahApps.Colors.Accent1}" />
            </Border>
            <Grid Grid.Row="1" Grid.Column="1" MinHeight="448" MinWidth="577">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="0.7*" />
                    <RowDefinition Height="0.7*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="0.7*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="0.7*" />
                    <RowDefinition Height="1*" />

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="100*"/>
                    <ColumnDefinition Width="227*" />
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="145" />
                </Grid.ColumnDefinitions>

                <Label Content="{DynamicResource Connect_label_connectsetting}" Grid.Row="1" Grid.Column="0"
                   FontSize="16" Foreground="#FF0E3193"
                   VerticalAlignment="Center"
                   BorderBrush="{DynamicResource MahApps.Colors.Accent1}" Grid.ColumnSpan="2" Margin="0,2" />

                <StackPanel Orientation="Horizontal" Grid.Row="3"  Grid.Column="0"  Grid.ColumnSpan="2">
                    <TextBlock Style="{StaticResource HoverUnderlineStyle}"
                               Margin="20, 0,0,0"
                               VerticalAlignment="Center"
                               
                               TextDecorations="Underline"
                               Text="{DynamicResource Connect_label_ip}" FontSize="13"
                               MouseLeftButtonDown="IpClick"/>
                    <TextBlock   Margin="0, 0,0,0" VerticalAlignment="Center"
                     Text="/" FontSize="13"/>
                    <TextBlock Style="{StaticResource HoverUnderlineStyle}"
                               Margin="0, 0,0,0"
                               TextDecorations="Underline"
                               VerticalAlignment="Center"
                               Text="{DynamicResource Connect_label_com}" FontSize="13"
                               MouseLeftButtonDown="ComClick" />
                </StackPanel>
                <TextBox Style ="{StaticResource MaterialDesignTextBox}" 
                         Grid.Row="3"  Grid.Column="2"
                         Grid.ColumnSpan="3"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                         GotFocus="tbxReaderAddr_GotFocus"
                         x:Name="tbxReaderAddr"
                         Text="{Binding ReaderAddr}"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="{DynamicResource Connect_textbox_iphint}" 
                         materialDesign:TextFieldAssist.HasClearButton="True"
                             Width="220" FontSize="13">

                </TextBox>

                <StackPanel Orientation="Horizontal" Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2">

                    <TextBlock  Margin="20, 0,0,0" 
                                                       VerticalAlignment="Center"
                                                       Text="{DynamicResource Connect_label_devtype}" FontSize="13"/>
                </StackPanel>

                <StackPanel   Orientation="Horizontal" Grid.Row="2"  Grid.Column="2"  Grid.ColumnSpan="2">
                    <ComboBox x:Name="cbbDevType" Style="{StaticResource MaterialDesignComboBox}"
                              Width="220" 
                              ItemsSource="{DynamicResource List_DevAntPortType}"
                              materialDesign:HintAssist.Hint="{DynamicResource Connect_combobox_devhint}" 
                              VerticalContentAlignment="Center"
                              FontSize="13" SelectionChanged="cbbDevType_SelectionChanged"/>
                </StackPanel>

                <!--<Border  BorderThickness="0,0,0,0" BorderBrush="#100E3193" Grid.ColumnSpan="3" 
                         Height="2" VerticalAlignment="Center"
                         Grid.Row="3"  Grid.Column="0" Margin="0,16"  />-->

                <StackPanel Orientation="Horizontal" Grid.Row="4" Height="45"  Grid.Column="2" Margin="0, 5,0,0">
                    <Button x:Name="btnConnect" Width="45" VerticalAlignment="Center"  Grid.Column="0" 
                                    Height="45" Click="btnConnect_Click" 
                                    IsEnabled="{Binding Path=IsConnect, Converter={StaticResource MyBoolConvert}}"
                                    Foreground="Green"
                                    Margin="0, 0,0,0"
                                    Padding="0,0,0,0"
                                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    HorizontalAlignment="Left"
                                    ToolTip="{DynamicResource Connect_button_connecttip}"
                                    Style="{StaticResource MaterialDesignIconButton}">
                        <materialDesign:PackIcon Kind="Link" Width="28" Height="28"/>
                    </Button>


                    <Button Width="45" x:Name="btnDisconnect"
                                    Grid.Column="1"
                                    IsEnabled="{Binding IsConnect}"
                                    Height="45"
                                    Click="btnDisconnect_Click"
                                    Margin="120, 0,0,0"
                                    Padding="0,0,0,0"
                                    Foreground="Red"
                                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    HorizontalAlignment="Left"
                                    ToolTip="{DynamicResource Connect_button_disconnecttip}"
                                    Style="{StaticResource MaterialDesignIconButton}">
                        <materialDesign:PackIcon Kind="LinkOff" Width="28" Height="28"/>
                    </Button>
                </StackPanel>
                <Border  BorderThickness="0,0,0,2" BorderBrush="#100E3193" Grid.ColumnSpan="3" 
                         Height="2" VerticalAlignment="Center"
                         Grid.Row="5"  Grid.Column="0" Margin="0,7,0,8"  />

                <Label Content="{DynamicResource Connect_label_hwinfo}" Grid.Row="6" Grid.Column="0"
                   FontSize="16" Foreground="#FF0E3193"
                   VerticalAlignment="Center"
                   BorderBrush="{DynamicResource MahApps.Colors.Accent1}" Grid.ColumnSpan="2" Margin="0,2" />

                <StackPanel Orientation="Horizontal" Grid.Row="7"  Grid.Column="0"  Grid.ColumnSpan="3">
                    <TextBlock  Margin="20, 0,0,0" 
                                                       VerticalAlignment="Center"
                                                       Text="{DynamicResource Connect_label_mainboardtype}" FontSize="13"/>

                </StackPanel>
                <TextBlock Grid.Row="7"  Grid.Column="2" x:Name="tbBoardType"
                                                       VerticalAlignment="Center"                                                        
                                                       Text="{Binding BoardType}" FontSize="13" Margin="0,9,0,8"/>

                <StackPanel Orientation="Horizontal" Grid.Row="8"  Grid.Column="0" Grid.ColumnSpan="2">

                    <TextBlock  Margin="20, 0,0,0" 
                                                       VerticalAlignment="Center"
                                                       Text="{DynamicResource Connect_label_modtype}" FontSize="13"/>
                </StackPanel>

                <TextBlock   Grid.Row="8"  Grid.Column="2"  x:Name="tbModType"
                                                       VerticalAlignment="Center"                                                        
                                                       Text="{Binding ModType}" FontSize="13" Margin="0,9,0,8"/>

                <Border  BorderThickness="0,0,0,2" BorderBrush="#100E3193" Grid.ColumnSpan="3" 
                         Height="2" VerticalAlignment="Center"
                         Grid.Row="9"  Grid.Column="0" Margin="0,8"  />


                <Label Content="{DynamicResource Connect_label_hwinfo}" Grid.Row="10" Grid.Column="0"
                   FontSize="16" Foreground="#FF0E3193"
                   VerticalAlignment="Center"
                   BorderBrush="{DynamicResource MahApps.Colors.Accent1}" Grid.ColumnSpan="2" Margin="0,2" />

                <StackPanel Orientation="Horizontal" Grid.Row="11"  Grid.Column="0"  Grid.ColumnSpan="3">

                    <TextBlock  Margin="20, 0,0,0" 
                                                       VerticalAlignment="Center"
                                                       Text="{DynamicResource Connect_label_hwversion}" FontSize="13"/>
                </StackPanel>
                <TextBlock  Grid.Row="11"  Grid.Column="2" x:Name="tbHardwareVer"
                                                       VerticalAlignment="Center"                                                        
                                                       Text="{Binding HardwareVer}" FontSize="13" Margin="0,9,0,8"/>
                <StackPanel Orientation="Horizontal" Grid.Row="11"  Grid.Column="3"  Grid.ColumnSpan="3">
                    <TextBlock  Margin="0, 0,0,0" VerticalAlignment="Center"
                     Text="{DynamicResource Connect_label_mainboard_hwversion}" FontSize="13"/>
                </StackPanel>
                <TextBlock  Grid.Row="11"  Grid.Column="4" x:Name="tbHardwareVer1"  VerticalAlignment="Center" FontSize="13" Margin="0,9,0,8"/>
                <StackPanel Orientation="Horizontal" Grid.Row="12"  Grid.Column="0" Grid.ColumnSpan="2">

                    <TextBlock Margin="20, 0,0,0" 
                                                       VerticalAlignment="Center"
                                                       Text="{DynamicResource Connect_label_swversion}" FontSize="13"/>
                </StackPanel>

                <TextBlock  Grid.Row="12"  Grid.Column="2"  x:Name="tbSoftwareVer"
                                                       VerticalAlignment="Center"                                                        
                                                       Text="{Binding SoftwareVer}" FontSize="13" Margin="0,9"/>
                <StackPanel Orientation="Horizontal" Grid.Row="12"  Grid.Column="3"  Grid.ColumnSpan="3">
                    <TextBlock  Margin="0, 0,0,0" VerticalAlignment="Center"
                     Text="{DynamicResource Connect_label_mainboard_swversion}" FontSize="13"/>
                </StackPanel>
                <TextBlock  Grid.Row="12"  Grid.Column="4" x:Name="tbSoftwareVer1"
                                                       VerticalAlignment="Center"                                                        
                                                       Text="{Binding MainboardVer}" FontSize="13" Margin="40,9,0,8"/>

                <Border  BorderThickness="0,0,0,2" BorderBrush="#100E3193" Grid.ColumnSpan="3" 
                         Height="2" VerticalAlignment="Center"
                         Grid.Row="13"  Grid.Column="0" Margin="0,7,0,8"  />

                <Label Content="{DynamicResource Connect_label_software}" Grid.Row="14" Grid.Column="0"
                   FontSize="16" Foreground="#FF0E3193"
                   VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="0,2"
                    />
                <StackPanel Orientation="Horizontal" Grid.Row="14"   Grid.Column="2">
                    <TextBlock  Margin="0, 0,30,0" 
                                VerticalAlignment="Center"
                                Name="SoftwareVersions"
                                FontSize="16"/>
                    <TextBlock Style="{StaticResource HoverUnderlineStyle}"
                               Margin="0, 0,0,0"
                               Name="VersionUpdates"
                               Visibility="Collapsed"
                               VerticalAlignment="Center"
                               Text="{DynamicResource Connect_label_software_VersionUpdates}" 
                               Foreground="#FF0E3193"
                               MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
                </StackPanel>


            </Grid>
        </Grid>


    </ScrollViewer>
</UserControl>