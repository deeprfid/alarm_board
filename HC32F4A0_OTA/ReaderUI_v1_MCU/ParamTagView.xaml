<UserControl 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReaderManager" xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"  
             xmlns:controlzex="urn:controlzex" x:Class="ReaderManager.ParamTagView"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <x:Array x:Key="storage" Type="{x:Type sys:String}">
            <sys:String>5</sys:String>
            <sys:String>10</sys:String>
            <sys:String>20</sys:String>
            <sys:String>30</sys:String>
        </x:Array>


        <Style TargetType="{x:Type ListView}" x:Key="ListViewBorderStyle">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

    </UserControl.Resources>
        <Grid>
            <Grid x:Name="gdMain" >

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" >

                    <ListView ScrollViewer.VerticalScrollBarVisibility="Visible" Style="{StaticResource ListViewBorderStyle}" Grid.Row="1"  x:Name="listTag" BorderBrush="Black" BorderThickness="1" 
                       FontSize="12.5" Margin="20,10,10,0" MinWidth="300" MinHeight ="300" MaxHeight="300" >
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Padding" Value="0,1,0,1"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View >
                        <GridView x:Name="lvWhite" >
                            <GridViewColumn  Header="{DynamicResource ParamSettings_white_listNo}" Width="150" DisplayMemberBinding="{Binding no}" />
                            <GridViewColumn  Header="{DynamicResource ParamSettings_tag_listCode}" Width="250" DisplayMemberBinding="{Binding tag}"/>
                            <GridViewColumn Header="{DynamicResource ParamSettings_tag_listFlag}" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source= "{Binding image}" Width="16" Height="16" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{DynamicResource ParamSettings_tag_listWhite}" Width="100" DisplayMemberBinding="{Binding flag}"/>

                        </GridView>
                    </ListView.View>
                      </ListView>
                  
                </Grid>
      

                <Grid Grid.Row="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="40*"/>
                </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Label  Style="{StaticResource paramLabelStyle}" FontSize="13" Content="{DynamicResource ParamSettings_ParamInter_ipaddr}" HorizontalAlignment="Left" Margin="5,10,5,0" HorizontalContentAlignment="Left"  />
                        <ComboBox x:Name="cbDevIp" Style="{StaticResource paramComboBoxStyle}"   IsEnabled="{Binding EnableFreqHopMode}" Width="150" VerticalAlignment="Center" HorizontalAlignment="Right" IsEditable="True" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <Button x:Name="btnStart" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_tag_start}"  VerticalAlignment="Center" Margin="0,10,0,0" Width="80" Click="btnStart_Click"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Button x:Name="btnEnd" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_tag_stop}" VerticalAlignment="Center" Margin="0,10,0,0" Width="80" Click="btnStop_Click"/>
                    </Grid>
                    <Grid Grid.Column="3">
                       <Button x:Name="btnClear" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_eas_easClear}" VerticalAlignment="Center" Margin="0,10,0,0" Width="80" Click="btnClear_Click"/>
                    </Grid>
            </Grid>
            </Grid>
        </Grid>
</UserControl>
