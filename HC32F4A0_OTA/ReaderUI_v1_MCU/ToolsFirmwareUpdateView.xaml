<UserControl x:Class="ReaderManager.ToolsFirmwareUpdateView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             SizeChanged="UserControl_SizeChanged" Loaded="UserControl_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid x:Name="gdMain" Margin="0,10,0,0" Loaded="GdMain_Loaded" >
        <Grid.RowDefinitions>
            <RowDefinition Height="30" MinHeight="30"/>
            <RowDefinition Height="48" MinHeight="48"/>
            <RowDefinition Height="20" MinHeight="20"/>
            <RowDefinition Height="30" MinHeight="30"/>
            <RowDefinition Height="48" MinHeight="48"/>
            <RowDefinition Height="20" MinHeight="20"/>
            <RowDefinition Height="48" MinHeight="48"/>
        </Grid.RowDefinitions>

        <Label Content="{DynamicResource FirmwareUpdateView_UpdFwParams}" 
             Grid.Row="0" Style="{StaticResource paramLabelStyle}"/>
       
        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <!--<ColumnDefinition Width="*" />-->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>
            <!--<ComboBox x:Name="FirmwareTypeName"  Style="{StaticResource paramComboBoxStyle}"  Grid.Column="0"
                      SelectedIndex="{Binding FirmwareType}"
                                  ItemsSource="{StaticResource FirmwareUpdateView_Type}"
                                  materialDesign:HintAssist.Hint="{DynamicResource FirmwareUpdateView_FirmwareType}"/>-->
            <TextBox Style ="{StaticResource paramTextBoxStyle}" 
                             Grid.Column="0"  Text="{Binding UpdFwReaderAddr}"
                         materialDesign:HintAssist.Hint="{DynamicResource FirmwareUpdateView_Parmas_RdAddr}" />
            <TextBox Style ="{StaticResource paramTextBoxStyle}"  MaxWidth="300" Grid.ColumnSpan="2"
                             Grid.Column="1" Text="{Binding UpdFwFilePath}"
                         materialDesign:HintAssist.Hint="{DynamicResource FirmwareUpdateView_Parmas_FwFile}" />
            <Button  VerticalAlignment="Center"  Grid.Column="3" Margin="0,15, 0, 0"                                   
                                    HorizontalAlignment="Right" Height="25" 
                                    IsEnabled="{Binding Path=IsUpdFw, Converter={StaticResource MyBoolConvert}}"
                                 x:Name="btnBrowse" Click="btnBrowse_Click"
                                    Content="{DynamicResource FirmwareUpdateView_btnBrowse}"                                    
                                    ToolTip="{DynamicResource FirmwareUpdateView_btnBrowse_tip}" 
                                    Style="{StaticResource AccentSettingButtonStyle}" />
            <Button VerticalAlignment="Center"  Grid.Column="5" x:Name="btnUpdate" Height="25" 
                            IsEnabled="{Binding Path=IsUpdFw, Converter={StaticResource MyBoolConvert}}"
                                    Margin="0,15, 0, 0"
                                    HorizontalAlignment="Right" Click="btnUpdate_Click" 
                                    Content="{DynamicResource FirmwareUpdateView_btnUpdate}"                                                                    
                                    ToolTip="{DynamicResource FirmwareUpdateView_btnUpdateTip}"
                                    Style="{StaticResource AccentSettingButtonStyle}" />

        </Grid>
        <Border  Style="{StaticResource paramBorderStyle}"  Grid.Row="2" />

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Label Content="{DynamicResource FirmwareUpdateView_Progress}" 
                           Style="{StaticResource fwUpdProgLabel}" />
            <Label Content="{Binding UpdFwPercent}" Margin="10,0,0,0"
                   Style="{StaticResource fwUpdProgLabel}"/>
            <Label Content="{DynamicResource FirmwareUpdateView_FwVersion}" 
                     Style="{StaticResource fwUpdProgLabel}" Margin="43,0,0,0" />
            <Label Content="{Binding UpdFwVersion}"
                Style="{StaticResource paramLabelStyle}" Margin="10,0,0,0"/>
            <TextBlock Style="{StaticResource HoverUnderlineStyle}"
                       Margin="0, 0,0,0"
                       Name="SoftwareVersion"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"
                       Text="{DynamicResource Connect_label_software_VersionUpdates}" 
                       Foreground="#FF0E3193"
                       TextDecorations="Underline"
                       MouseLeftButtonDown="SoftwareVersionClick"
                       />
        </StackPanel>
        <mah:MetroProgressBar x:Name="pbFwUpdProg"    Grid.Row="4" Height="10"
                              Background="Transparent" 
                             Value="{Binding UpFwProgress}" HorizontalAlignment="Stretch"
                              Margin="20,12,0,12"/>
        
        <Border  Style="{StaticResource paramBorderStyle}" Grid.Row="5" />
        
        <!--<Button VerticalAlignment="Center"  Grid.Row="6" Margin="0,0, 100, 0"   
                            IsEnabled="{Binding Path=IsUpdFw, Converter={StaticResource MyBoolConvert}}"
                                    HorizontalAlignment="Right" Height="25" 
                                    x:Name="btnGet" Click="btnGet_Click"
                                    Content="{DynamicResource ParamSettings_button_get}"                                    
                                    ToolTip="{DynamicResource FirmwareUpdateView_btnGetTip}" 
                                    Style="{StaticResource AccentSettingButtonStyle}" />-->
        
    </Grid>
</UserControl>
