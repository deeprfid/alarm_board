<UserControl x:Class="ReaderManager.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

             <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="23*" />
            </Grid.ColumnDefinitions>
            
            <TabControl  Grid.Column="1" Grid.Row="1"  x:Name="tcParamMuem" 
                         MinHeight="448" MinWidth="577"
                        mah:TabControlHelper.Underlined="TabItems" 
                        mah:TabControlHelper.UnderlinePlacement="Right"                   
                    mah:HeaderedControlHelper.HeaderFontSize="15"                    
                    TabStripPlacement="Top" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                <TabItem Header="{DynamicResource Activemode_StaticParameterConfiguration}" >
                    <local:StaticModelView/>
                </TabItem>
                <TabItem Header="{DynamicResource Activemode_AdvancedParameterConfiguration}">
                    <local:ActiveModeView/>
                </TabItem>
            </TabControl>
        </Grid>
    
</UserControl>
