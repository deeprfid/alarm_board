<UserControl x:Class="ReaderManager.FlyBottomPotlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
        </Grid.ColumnDefinitions>

        <mah:ToggleSwitch x:Name="tsIsPotlPrint"  Grid.Row="1"  Grid.Column="1" IsOn="{Binding IsPotlPrint}"
                              OffContent="{DynamicResource FlyView_Bottom_Potl_Debug_Off}"  Style="{StaticResource paramToggleSwitchStyle}"
                              OnContent="{DynamicResource FlyView_Bottom_Potl_Debug_On}" Toggled="IsPotlPrint_Toggled" />

        <Button x:Name="btnClear" Width="32" VerticalAlignment="Center" Grid.Column="1"
                                    Click="btnClear_Click" Grid.Row="1"
                                    Height="32"
                                    Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                    Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                    HorizontalAlignment="Right"
                                    ToolTip="点击清空"
                                    Style="{StaticResource MaterialDesignIconButton}">
            <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" />
        </Button>


        <TextBox Grid.Row="2"  x:Name="tbResult" Grid.Column="1" 
                    FontSize="13"   Text="{Binding PotlString}"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    VerticalAlignment="Stretch"
                    Margin="0,10,0, 0"
                    BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    TextAlignment="Left"
                    IsReadOnly="True"
                    Padding="10,10,10,5"
                    VerticalScrollBarVisibility="Auto"
                    materialDesign:HintAssist.FloatingOffset="-10,-20"
                    materialDesign:HintAssist.Hint="{DynamicResource FlyView_Bottom_Potl_PotlData}"
                    materialDesign:HintAssist.FontFamily="Microsoft YaHei UI"
                    materialDesign:HintAssist.FloatingScale ="1.2"
                    FontFamily="Microsoft YaHei UI"        
                    materialDesign:HintAssist.IsFloating="True"
                   materialDesign:HintAssist.Foreground="{DynamicResource MahApps.Brushes.AccentBase}"/>
    </Grid>
</UserControl>
