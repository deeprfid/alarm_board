<UserControl 
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:ReaderManager" 
          xmlns:sys="clr-namespace:System;assembly=mscorlib"
          xmlns:local_Models="clr-namespace:ReaderManager.Models"
          xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
          xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"  
          xmlns:controlzex="urn:controlzex" x:Class="ReaderManager.ParamLogView"
          xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
          mc:Ignorable="d" 
          d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <Style TargetType="{x:Type ListView}" x:Key="ListViewBorderStyle">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Grid x:Name="gdMain" >

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label Content="{DynamicResource ParamSettings_eas_logstart}" Style="{StaticResource paramLabelStyle}"  FontSize="13" HorizontalAlignment="Left" Height="26" Margin="0,10,0,0" HorizontalContentAlignment="Center"/>
                    <TextBox x:Name="tbStart" Style ="{StaticResource paramTextBoxStyle}" Width="130" Text="{Binding startTime}" HorizontalAlignment="Center" />
                </Grid>
                <Grid Grid.Column="1">
                    <Label Content="{DynamicResource ParamSettings_eas_logend}" Style="{StaticResource paramLabelStyle}"  FontSize="13" HorizontalAlignment="Left" Margin="0,10,0,0" HorizontalContentAlignment="Center"/>
                    <TextBox x:Name="tbEnd"  Style ="{StaticResource paramTextBoxStyle}" Text="{Binding endTime}"      
            Width="130" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Stretch"/>
                </Grid>

            </Grid>
            <Grid Grid.Row="1" >

                <ListView ScrollViewer.VerticalScrollBarVisibility="Visible" Style="{StaticResource ListViewBorderStyle}" Grid.Row="1"  x:Name="listAlarm" BorderBrush="Black" BorderThickness="1" 
                       FontSize="12.5" Margin="20,10,10,0" MinWidth="300" MinHeight ="400" MaxHeight="600" >
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="Padding" Value="0,1,0,1"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View >
                        <GridView x:Name="lvAlarm" >
                            <GridViewColumn  Header="{DynamicResource ParamSettings_eas_listNo}" Width="150" DisplayMemberBinding="{Binding deviceNo}" />
                            <GridViewColumn  Header="{DynamicResource ParamSettings_eas_listCode}" Width="400" DisplayMemberBinding="{Binding epc}"/>
                            <GridViewColumn  Header="{DynamicResource ParamSettings_eas_listTime}" Width="200" DisplayMemberBinding="{Binding time}"/>
                            <GridViewColumn  Header="{DynamicResource ParamSettings_eas_listMem}" Width="50" DisplayMemberBinding="{Binding mem}"/>

                        </GridView>
                    </ListView.View>
                </ListView>

            </Grid>


            <Grid Grid.Row="2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="295*"/>
                    <ColumnDefinition Width="168*"/>
                    <ColumnDefinition Width="168*"/>
                    <ColumnDefinition Width="168*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,168,0">
                    <Label  Style="{StaticResource paramLabelStyle}" FontSize="13" Content="{DynamicResource ParamSettings_ParamInter_ipaddr}" HorizontalAlignment="Left" Margin="20,10,0,0" HorizontalContentAlignment="Center"  />
                    <ComboBox x:Name="cbDevIp" Style="{StaticResource paramComboBoxStyle}"   IsEnabled="{Binding EnableFreqHopMode}"  Width="150" VerticalAlignment="Center" HorizontalAlignment="Center" IsEditable="True" />
                </Grid>
                <Grid Grid.Column="1">
                    <Button x:Name="btnGet" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_button_get}"  VerticalAlignment="Center" Width="70" Click="btnGet_Click"/>
                </Grid>
                <Grid Grid.Column="2" >
                    <Button x:Name="btnClear" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_eas_easClear}" VerticalAlignment="Center" Width="70" Click="btnClear_Click"/>
                </Grid>
                <Grid Grid.Column="3" Cursor="">
                    <Button x:Name="btnFile" Style="{StaticResource AccentSettingButtonStyle}" Content="{DynamicResource ParamSettings_white_writefile}"   VerticalAlignment="Center"  Width="70" Click="btnWriteFile_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>


