<UserControl x:Class="ReaderManager.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             d:DesignHeight="450" d:DesignWidth="650">

    <ScrollViewer
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="23*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"  Grid.Column="1"  BorderThickness="0,0,0,2" BorderBrush="#100E3193">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Content="{DynamicResource HamburgerMenu_tools}"  Grid.Column="0"
                   FontSize="19" Foreground="{StaticResource MahApps.Brushes.AccentBase}"
                   VerticalAlignment="Center"
                   BorderBrush="{DynamicResource MahApps.Colors.Accent1}" />
                </Grid>
            </Border>

            <TabControl  Grid.Column="1" Grid.Row="1"  x:Name="tcParamMuem" 
                         MinHeight="448" MinWidth="577"
                        mah:TabControlHelper.Underlined="TabItems" 
                        mah:TabControlHelper.UnderlinePlacement="Right"                   
                    mah:HeaderedControlHelper.HeaderFontSize="15"                    
                    TabStripPlacement="Top" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                <TabItem Header="{DynamicResource ToolsView_tabitem_firmwareupdate}" >
                    <local:ToolsFirmwareUpdateView/>
                </TabItem>
                <TabItem Header="{DynamicResource ToolsView_tabitem_vswrcheck}">
                    <local:ToolsVswrCheckView/>
                </TabItem>
                <TabItem Header="{DynamicResource ToolsView_tabitem_devsearch}">
                    <local:ToolsDevSearchView/>
                </TabItem>
                <TabItem Header="{DynamicResource ToolsView_tabitem_mcuupdate}">
                    <local:OtaUpdateView/>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
