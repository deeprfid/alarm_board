<UserControl x:Class="ReaderManager.TagOpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             d:DesignHeight="500"
             d:DesignWidth="800"
             mc:Ignorable="d" Loaded="UserControl_Loaded" IsVisibleChanged="UserControl_IsVisibleChanged"
             SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <x:Array x:Key="lockObjItems" Type="sys:String">
            <sys:String>Access Password</sys:String>
            <sys:String>Kill Password</sys:String>
            <sys:String>EpcBank</sys:String>
            <sys:String>TidBank</sys:String>
            <sys:String>UserBank</sys:String>
        </x:Array>
    </UserControl.Resources>
    
    <ScrollViewer
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="11*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="23*" />
                <ColumnDefinition Width="3*" MinWidth="40"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"  Grid.Column="1"  BorderThickness="0,0,0,2" BorderBrush="#100E3193">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="{DynamicResource HamburgerMenu_tagop}" Grid.Column="0"
                   FontSize="19" Foreground="{StaticResource MahApps.Brushes.AccentBase}"
                   VerticalAlignment="Center"
                   BorderBrush="{DynamicResource MahApps.Colors.Accent1}" />

                    <Button x:Name="btnRun" Width="65" VerticalAlignment="Center"  Grid.Column="1" 
                                    Height="30" Click="btnRun_Click"
                                    HorizontalAlignment="Right"
                                    IsEnabled="{Binding IsConnect}"
                                    Content="{DynamicResource TagOpView_Exec}"
                                    FontSize="12.5"
                                    BorderBrush="{StaticResource MahApps.Brushes.AccentBase}"
                                    BorderThickness="2"
                                    ToolTip="{DynamicResource TagOpView_ExecuteTip}" 
                                    FontFamily="Microsoft YaHei UI" FontWeight="Normal"
                                    Style="{StaticResource AccentSettingButtonStyle}">

                    </Button>

                </Grid>
            </Border>


            <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" x:Name="gdMain">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" MinHeight="30"/>
                    <RowDefinition Height="48" MinHeight="48"/>
                    <RowDefinition Height="20" MinHeight="20"/>
                    <RowDefinition Height="30" MinHeight="30"/>
                    <RowDefinition Height="48" MinHeight="48"/>
                    <RowDefinition Height="20" MinHeight="20"/>
                    <RowDefinition Height="30" MinHeight="30"/>
                    <RowDefinition Height="48" MinHeight="48"/>
                    <RowDefinition Height="20" MinHeight="20"/>
                        <RowDefinition Height="*" Tag="NoChange"/>
                    </Grid.RowDefinitions>

                <Label Content="{DynamicResource TagOpView_OpCommonParams}" 
                       Grid.Row="0" Style="{StaticResource paramLabelStyle}" />
                    <Grid Grid.Row="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                        <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="0"
                                  ItemsSource="{DynamicResource List_TagOpView_OpType}"
                                  materialDesign:HintAssist.Hint="{DynamicResource TagOpView_OpType}" 
                                  x:Name="cbbOpType" SelectedIndex="{Binding TagOpType}" />
                        <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="1"
                                  materialDesign:HintAssist.Hint="{DynamicResource TagOpView_OpAnt}" 
                                  x:Name="cbbOpAnt" SelectedIndex="{Binding TagOpAnt}"/>
                        <TextBox Style ="{StaticResource paramTextBoxStyle}" 
                             Grid.Column="3"  Text="{Binding TagOpKillPwd}"               
                         materialDesign:HintAssist.Hint="{DynamicResource TagOpView_KillPwd}"  />
                        <TextBox Style ="{StaticResource paramTextBoxStyle}" 
                             Grid.Column="2"  Text="{Binding TagOpAccessPwd}" 
                         materialDesign:HintAssist.Hint="{DynamicResource TagOpView_AcsPwd}" />
                    </Grid>
                <Border  Style="{StaticResource paramBorderStyle}" Grid.Row="2" />

                <Label Content="{DynamicResource TagOpView_ReadWriteParams}" 
                       Grid.Row="3" Style="{StaticResource paramLabelStyle}" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="0"
                                  materialDesign:HintAssist.Hint="Bank"  SelectedIndex="{Binding TagOpBank}"
                                  ItemsSource="{DynamicResource Gen2Banks}" SelectionChanged="ComboBox_SelectionChanged"/>
                        <TextBox Style ="{StaticResource paramTextBoxStyle}" 
                             Grid.Column="1"  Text="{Binding TagOpStartAddr}"
                         materialDesign:HintAssist.Hint="{DynamicResource ParamSettings_ParamInv_adddata_combobox_startaddr_hint}" />
                        <TextBox Style ="{StaticResource paramTextBoxStyle}" 
                             Grid.Column="2"  Text="{Binding TagOpBlkCnt}"
                         materialDesign:HintAssist.Hint="{DynamicResource TagOpView_ReadBlkCnt}" />
                    </Grid>
                    <Border  Style="{StaticResource paramBorderStyle}" Grid.Row="5" />

                <Label Content="{DynamicResource TagOpView_LockParams}" Grid.Row="6"
                       Style="{StaticResource paramLabelStyle}" />

                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                        <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="0"
                                  SelectedIndex="{Binding TagOpLockObj}"
                                  materialDesign:HintAssist.Hint="{DynamicResource TagOpView_LockObj}" 
                                  ItemsSource="{StaticResource lockObjItems}"/>
                        <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="1"
                                  SelectedIndex="{Binding TagOpLockType}"
                                  ItemsSource="{DynamicResource List_TagOpView_LockType}"
                                  materialDesign:HintAssist.Hint="{DynamicResource TagOpView_LockType}" 
                                  x:Name="cbbLockType" />
                    </Grid>
                <Border  Style="{StaticResource paramBorderStyle}"  Grid.Row="8" />

                    <TextBox Grid.Row="9" Margin="0,8,0,0" x:Name="tbResult"
                    FontSize="13"  Text="{Binding TagOpHexData}"    
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    VerticalAlignment="Stretch"
                    Width="575"
                    MinWidth="575"
                    HorizontalAlignment="Left"        
                    BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    TextAlignment="Left"
                    Padding="10,10,10,5"
                    VerticalScrollBarVisibility="Auto"
                    materialDesign:HintAssist.FloatingOffset="-10,-20"
                    materialDesign:HintAssist.Hint="{DynamicResource TagOpView_DataAndResult}"
                    materialDesign:HintAssist.FontFamily="Microsoft YaHei UI"
                    materialDesign:HintAssist.FloatingScale ="1.2"
                    FontFamily="Microsoft YaHei UI"        
                    materialDesign:HintAssist.IsFloating="True"
                   materialDesign:HintAssist.Foreground="{DynamicResource MahApps.Brushes.AccentBase}"/>                 
            </Grid>
        </Grid >
    </ScrollViewer>
</UserControl>