<UserControl x:Class="ReaderManager.ToolsVswrCheckView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReaderManager"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:local_Models="clr-namespace:ReaderManager.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
            IsVisibleChanged ="UserControl_IsVisibleChanged"
             Loaded ="UserControl_Loaded" SizeChanged="UserControl_SizeChanged"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <Style   BasedOn="{StaticResource MahApps.Styles.Label}"   x:Key="fwUpdProgLabel"
               TargetType="Label"  >
            <Setter Property="Foreground" Value="#FF0E3193" />
            <Setter Property="FontSize" Value="15" />
        </Style>

    </UserControl.Resources>

    <Grid x:Name="gdMain" Margin="0,10,0,0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="30" MinHeight="30"/>
            <RowDefinition Height="48" MinHeight="48"/>
            <RowDefinition Height="20" MinHeight="20"/>
            <RowDefinition Height="30" MinHeight="30"/>
            <RowDefinition Height="10" MinHeight="10"/>
            <RowDefinition Height="200" MinHeight="200"/>

        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Content="{DynamicResource ToolsView_vswrcheck_checkparams}" 
               Grid.Column="0" Style="{StaticResource paramLabelStyle}"/>
        </Grid>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox Style="{StaticResource paramComboBoxStyle}"  Grid.Column="0"
                                  materialDesign:HintAssist.Hint="{DynamicResource ToolsView_vswrcheck_checkant}" 
                                  x:Name="cbbOpAnt" SelectedIndex="{Binding VswrCheckAnt}"/>
            
            <TextBox Style ="{StaticResource paramTextBoxStyle}"  
                             Grid.Column="1" Text="{Binding VswrCheckPower}"
                         materialDesign:HintAssist.Hint="{DynamicResource ToolsView_vswrcheck_txpower}" />
            
            <Button  VerticalAlignment="Center"  Grid.Column="4" Margin="0,15, 0, 0"                                   
                                    HorizontalAlignment="Right" Height="25"                    
                                 x:Name="btnGet" Click="btnGet_Click" 
                                    IsEnabled="{Binding IsConnect}"
                                      Content="{DynamicResource ParamSettings_button_get}"                                       
                                    ToolTip="{DynamicResource ToolsView_vswrcheck_btnGetTip}" 
                                    Style="{StaticResource AccentSettingButtonStyle}" />
        </Grid>
        <Border  Style="{StaticResource paramBorderStyle}"  Grid.Row="2" />

        <Label Content="{DynamicResource ToolsView_vswrcheck_chartvswr}" 
                   Grid.Row="3"  Style="{StaticResource fwUpdProgLabel}" />


        <lvc:CartesianChart x:Name="ccStickChart" Grid.Row="5" >
            <lvc:CartesianChart.DataTooltip>
                <lvc:DefaultTooltip SelectionMode="OnlySender" />
            </lvc:CartesianChart.DataTooltip>
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="{DynamicResource ToolsView_vswrcheck_chart_freq}" 
                          Labels="{Binding xlabelslist}" />
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="{DynamicResource ToolsView_vswrcheck_chart_vswr}"
                          MinValue="0"/>
            </lvc:CartesianChart.AxisY>

        </lvc:CartesianChart>

    </Grid>
</UserControl>
