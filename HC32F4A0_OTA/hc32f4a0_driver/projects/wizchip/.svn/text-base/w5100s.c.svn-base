}


/**
@brief   This function is being called by send() and sendto() function also.

This function read the Tx write pointer register and after copy the data in buffer update the Tx write pointer
register. User should read upper byte first and lower byte later to get proper value.
*/
void send_data_processing(SOCKET s, uint8 *data, uint16 len)		// MCU??????????W5100S??????W5100S??????д??buf?????????????д??????
{
    uint8 s_num;
    uint16 ptr =0;
    uint32 addrbsb =0;
    uint32 offset = 0;
    uint32  addr_offset = 0;
    uint32 uper_size;
    //uint8 i=0;
    s_num=s;
    if(len == 0)
    {
        printf("CH: %d Unexpected1 length 0\r\n", s);
        return;
    }

    ptr = (uint16)IINCHIP_READ( W5100S_Sn_TX_WR0(s) );
    ptr = (ptr << 8) + IINCHIP_READ(W5100S_Sn_TX_WR1(s));

    /*计算基地址偏移量*/
    while(s_num>0)
    {   s_num--;
        offset += getSn_TXBUF_SIZE( s_num)*1024;
    }
    /*计算地址偏移*/
    addr_offset = (ptr&(getSn_TXBUF_SIZE( s)*1024-1));

    if((addr_offset+len)>getSn_TXBUF_SIZE( s)*1024)
    {
        uper_size =  getSn_TXBUF_SIZE( s)*1024 - addr_offset;
        addrbsb = (uint32)(addr_offset+0x4000+offset);
        wiz_write_buf(addrbsb, data, uper_size);
        addrbsb = 0x4000+offset;
        wiz_write_buf(addrbsb, data+uper_size,len-uper_size);
    }
    else
    {
        addrbsb = (uint32)((ptr&(getSn_TXBUF_SIZE( s)*1024-1))+0x4000+offset);	// ??????????н??????????????????32λ
        //printf("sendaddr=%lx\r\n",addrbsb);
        wiz_write_buf(addrbsb, data, len);														// W5100S??????????д???????????????len
    }
    ptr += len;																										// ???????+len????????μ?????
    IINCHIP_WRITE( W5100S_Sn_TX_WR0(s) ,(uint8)((ptr & 0xff00) >> 8));
    IINCHIP_WRITE( W5100S_Sn_TX_WR1(s),(uint8)(ptr & 0x00ff));						// ???μ???????????Sn_RX_WR??
    ptr = (uint16)IINCHIP_READ( W5100S_Sn_TX_WR0(s) );
    ptr = (ptr << 8) + IINCHIP_READ(W5100S_Sn_TX_WR1(s));

}


/**
@brief  This function is being called by recv() also.

This function read the Rx read pointer register
and after copy the data from receive buffer update the Rx write pointer register.
User should read upper byte first and lower byte later to get proper value.
*/
void recv_data_processing(SOCKET s, uint8 *data, uint16 len)
{
    uint8 s_num;
    uint16 ptr = 0;
    uint32 addrbsb = 0;
    uint16 offset=0;
    uint32  addr_offset=0;
    uint32 uper_size;
    s_num=s;
    if(len == 0)
    {
        return;
    }
// Sn_RX_RD?????????????
    ptr = (uint16)IINCHIP_READ( 	W5100S_Sn_RX_RD0(s) );
//	printf("addr=%x\r\n",ptr);
    ptr = (ptr << 8) + IINCHIP_READ( W5100S_Sn_RX_RD1(s) );	// MCU???Sn_RX_RD????????
//  printf("addr=%x\r\n",ptr);
    addr_offset = (ptr&(getSn_RXBUF_SIZE( s)*1024-1));
    while(s_num>0)
    {   s_num--;
        offset += getSn_RXBUF_SIZE( s_num)*1024;
    }
    if((addr_offset+len)>getSn_RXBUF_SIZE( s)*1024)
    {
        uper_size = getSn_RXBUF_SIZE( s)*1024 -addr_offset;
        addrbsb =(uint32)(addr_offset+0x6000+offset);
        wiz_read_buf(addrbsb, data, uper_size);
        addrbsb =(uint32)(0x6000+offset);
        wiz_read_buf(addrbsb, data+uper_size, len-uper_size);
    } else
    {
        addrbsb =(uint32)((ptr&(getSn_RXBUF_SIZE( s)*1024-1))+0x6000+offset);					// ??????????н??????????????????32λ
        wiz_read_buf(addrbsb, data, len);										// W5100S??????????????????????????len
    }
    ptr += len;																					// ???????+len????????μ?????

    IINCHIP_WRITE( W5100S_Sn_RX_RD0(s), (uint8)((ptr & 0xff00) >> 8));
    IINCHIP_WRITE( W5100S_Sn_RX_RD1(s), (uint8)(ptr & 0x00ff));		// ???μ???????????Sn_RX_RD??
}
