//总线通信方式发送数据
void IINCHIP_BusSendData(uint32 addr,uint8 data)
{
    *((volatile uint8*)addr) = data;

}
//总线方式读数据
uint8 IINCHIP_BusReadData(uint32 addr)
{
    return *((volatile uint8*)addr) ;

}

//spi模式下的通信


static uint8 I_STATUS[MAX_SOCK_NUM];
static uint16 SSIZE[MAX_SOCK_NUM]; /**< Max Tx buffer size by each channel */
static uint16 RSIZE[MAX_SOCK_NUM]; /**< Max Rx buffer size by each channel */

//获取每个socket的端口状态
uint8 getISR(uint8 s)
{
    return I_STATUS[s];
}

//
void putISR(uint8 s, uint8 val)
{
    I_STATUS[s] = val;
}


//获取每个socket 接收缓冲区的大小
uint16 getIINCHIP_RxMAX(uint8 s)
{
    return RSIZE[s];
}


//获取每个socket发送缓冲区的大小
uint16 getIINCHIP_TxMAX(uint8 s)
{
    return SSIZE[s];
}

//SPI片选信号拉低
void IINCHIP_CSoff(void)
{
    WIZ_CS(LOW);
}

//片选信号拉高
void IINCHIP_CSon(void)
{
    WIZ_CS(HIGH);
}

//SPI发送一个字节的数据
uint8  IINCHIP_SpiSendData(uint8 dat)
{
    return(SPI1_SendByte(dat));
}

//MCU通过SPI接口向W5100S写字节数据
/*
  SPI帧  |---8bits---|---16bits---|----DATA---|
            控制段      偏移地址       数据
  控制段： 0xf0 写
          0x0f 读
*/

void IINCHIP_WRITE( uint32 addrbsb,  uint8 data)   //2018-07-17
{
    //IINCHIP_ISR_DISABLE();                        // Interrupt Service Routine Disable

#if(MODE_SPI==1)
    IINCHIP_CSoff();
    delay_us(10);                          // CS=0, SPI start
    IINCHIP_SpiSendData( 0xf0);
    IINCHIP_SpiSendData( (addrbsb & 0xff00)>>8);// Address byte 1
    IINCHIP_SpiSendData( (addrbsb & 0x00ff));// Address byte 2
    IINCHIP_SpiSendData(data);                    // Data write (write 1byte data)
    IINCHIP_CSon();                              // CS=1,  SPI end

#elif(MODE_BUS==1)
    IINCHIP_BusSendData(IDM_AR0 ,(addrbsb & 0xff00)>>8);
    IINCHIP_BusSendData(IDM_AR1 ,addrbsb & 0x00ff);
    IINCHIP_BusSendData(IDM_DR, data);
#endif

    //IINCHIP_ISR_ENABLE();                         // Interrupt Service Routine Enable
}

//读取1byte数据
uint8 IINCHIP_READ(uint32 addrbsb)   //2018-07-17
{
    uint8 data = 0;

#if((MODE_SPI==1))
    //IINCHIP_ISR_DISABLE();                        // Interrupt Service Routine Disable
    IINCHIP_CSoff(); 	// CS=0, SPI start
    delay_us(10);
    {
        IINCHIP_SpiSendData( 0x0f);
        IINCHIP_SpiSendData( (addrbsb & 0xff00)>>8);// Address byte 1
        IINCHIP_SpiSendData( (addrbsb & 0x00ff));// Address byte 2
        // IINCHIP_SpiSendData( (addrbsb & 0x000000F8))    ;// Data read command and Read data length 1
        data = IINCHIP_SpiSendData(0x00);             // Data read (read 1byte data)
    }
    IINCHIP_CSon();                               // CS=1,  SPI end

#elif(MODE_BUS==1)
    {
        IINCHIP_BusSendData(IDM_AR0 ,(addrbsb & 0xff00)>>8);
        IINCHIP_BusSendData(IDM_AR1 ,(addrbsb & 0x00ff));
        data = IINCHIP_BusReadData(IDM_DR);
    }
#endif

//printf("data = %x\r\n",data);
    //IINCHIP_ISR_ENABLE();                         // Interrupt Service Routine Enable
    return data;
}


//写多个字节的数据
uint16 wiz_write_buf(uint32 addrbsb,uint8* buf,uint16 len)   //2018-07-17
{
    uint16 idx = 0;
    if(len == 0)
        addrbsb = addrbsb+COMMON_BASE;

    //IINCHIP_ISR_DISABLE();
#if(MODE_SPI==1)
    IINCHIP_CSoff(); 	// CS=0, SPI start
    delay_us(10);
    IINCHIP_SpiSendData( 0xf0);
    IINCHIP_SpiSendData( (addrbsb & 0xff00)>>8);// Address byte 1
    IINCHIP_SpiSendData( (addrbsb & 0x00ff));// Address byte 2
    for(idx = 0; idx < len; idx++)                // Write data in loop
    {
        IINCHIP_SpiSendData(buf[idx]);
        // delay_us(10);
    }
    IINCHIP_CSon();                               // CS=1, SPI end

#elif(MODE_BUS==1)
    IINCHIP_BusSendData(IDM_AR0 ,(addrbsb & 0xff00)>>8);
    IINCHIP_BusSendData(IDM_AR1 ,addrbsb & 0x00ff);

    for(idx = 0; idx < len; idx++)                // Write data in loop
    {
        IINCHIP_BusSendData(IDM_DR, buf[idx]);
    }
#endif

    //IINCHIP_ISR_ENABLE();                         // Interrupt Service Routine Enable

    return len;
}

uint16 wiz_read_buf(uint32 addrbsb, uint8* buf,uint16 len)      //2018-07-17
{
    uint16 idx = 0;
    if(len == 0)
    {

    }
    addrbsb = addrbsb+COMMON_BASE;
    //IINCHIP_ISR_DISABLE();
    //SPI MODE I/F

#if(MODE_SPI==1)
    IINCHIP_CSoff();	// CS=0, SPI start
    delay_us(10);
    IINCHIP_SpiSendData( 0x0f);
    IINCHIP_SpiSendData( (addrbsb & 0xff00)>>8);// Address byte 1
    IINCHIP_SpiSendData( (addrbsb & 0x00ff));// Address byte 2
    for(idx = 0; idx < len; idx++)                    // Write data in loop
    {
        buf[idx] = IINCHIP_SpiSendData(0x00);
    }
    IINCHIP_CSon();                                   // CS=1, SPI end

#elif(MODE_BUS==1)
    IINCHIP_BusSendData(IDM_AR0 ,(addrbsb & 0xff00)>>8);
    IINCHIP_BusSendData(IDM_AR1 ,addrbsb & 0x00ff);

    for(idx = 0; idx < len; idx++)                // Write data in loop
    {
        buf[idx] =IINCHIP_BusReadData(IDM_DR);
    }
#endif

    //IINCHIP_ISR_ENABLE();                             // Interrupt Service Routine Enable

    return len;
}


/**
@brief  This function is for resetting of the iinchip. Initializes the iinchip to work in whether DIRECT or INDIRECT mode
*/
void iinchip_init(void)
{
    setMR( MR_RST );
#ifdef __DEF_IINCHIP_DBG__
    printf("MR value is %02x \r\n",IINCHIP_READ_COMMON(MR));
#endif
}

/**
//RX memory size register, R/W, default=0x55
//--------------------------------------------------------    S1      S0      Memory size
//  Socket3    |  Socket2    |  Socket1    |  Socket0    |    0       0           1KB
//-------------|-------------|-------------|-------------|    0       1           2KB
//S1       S0  |S1       S0  |S1       S0  |S1       S0  |    1       0           4KB
//--------------------------------------------------------    1       1           8KB
*/
void sys_init( uint8  tx_size, uint8  rx_size  )
{

    IINCHIP_WRITE( W5100S_RMSR, tx_size);		//
    IINCHIP_WRITE( W5100S_TMSR, rx_size);		//


}

