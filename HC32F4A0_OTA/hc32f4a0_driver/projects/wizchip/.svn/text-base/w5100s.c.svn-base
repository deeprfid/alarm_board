/**
*@BRIEF:SET SOCKET-LESS INTERRUPT IR
******/
void setSLIR(uint8 val)
{

    IINCHIP_WRITE(W5100S_SLIR,val);

}
/**
*@brief:GET SOCKET-LESS IR
***/
uint8 getSLIR(void)
{
    uint8 val;
    val = IINCHIP_READ(W5100S_SLIR);
    return val;
}

/**
*@BRIEF: SET CLKLCKR
----------------------
 UNLOCK   | LOCK
----------------------
 0XCE     |OTHERS
----------------------
****/
void setCLKLCKR(uint8 val)
{

    IINCHIP_WRITE(W5100S_CLKLCKR,val);

}

/**
*@BRIEF: SET NET LOCK
------------------
UNLOCK   |  LOCK
------------------
0XC5     |  0X3A
------------------
***/
void setNETLCKR(uint8 val)
{

    IINCHIP_WRITE(W5100S_NETLCKR,val);

}
/*****
*@BRIEF:SET PHY LOCK
*---------------------------
* UNLOCK  |  LOCK
*------------------
* 0x53    |  others
*------------------
*********/
void setPHYLCKR(uint8 val)
{

    IINCHIP_WRITE(W5100S_PHYLCKR,val);

}

/***
*@BRIEF: GET VERSION
***/
uint8 getVERR(void)
{
    uint8 val;
    val = IINCHIP_READ(W5100S_VERR);
    return val;
}

/**
*@brief:get Ticker count
**/
uint8 getTCNTR (void)
{
    uint8 val1;
    uint16 val;
    val1 = IINCHIP_READ(W5100S_TCNTR);
    val = val1;
    val1 = IINCHIP_READ(W5100S_TCNTR+1);
    val = (val<<8)+val1;
    return val;
}
/**
*@brief:
**/
void setTCNTCLR(uint8 val)
{

    IINCHIP_WRITE(W5100S_TCNTCLR,val);

}

uint8 getSn_TXBUF_SIZE(uint8 s)
{
    return IINCHIP_READ(W5100S_Sn_TXBUF_SIZE(s));

}
uint8 getSn_RXBUF_SIZE(uint8 s)
{
    return IINCHIP_READ(W5100S_Sn_RXBUF_SIZE(s));

}
