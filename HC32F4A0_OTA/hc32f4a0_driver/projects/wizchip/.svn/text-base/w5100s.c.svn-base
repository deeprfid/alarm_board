/**
@brief  This function gets Interrupt register in common register.
 */
uint8 getIR( void )
{
    return IINCHIP_READ(W5100S_IR);
}

/**
@brief  This function sets up Retransmission time.

If there is no response from the peer or delay in response then retransmission
will be there as per RTR (Retry Time-value Register)setting
*/
void setRTR(uint16 timeout)
{
    IINCHIP_WRITE(W5100S_RTR0,(uint8)((timeout & 0xff00) >> 8));
    IINCHIP_WRITE(W5100S_RTR1,(uint8)(timeout & 0x00ff));
}

/**
@brief  This function set the number of Retransmission.

If there is no response from the peer or delay in response then recorded time
as per RTR & RCR register seeting then time out will occur.
*/
void setRCR(uint8 retry)
{
    IINCHIP_WRITE(W5100S_RCR,retry);
}

/**
@brief  This function set the interrupt mask Enable/Disable appropriate Interrupt. ('1' : interrupt enable)

If any bit in IMR is set as '0' then there is not interrupt signal though the bit is
set in IR register.
*/
void clearIR(uint8 mask)
{
    IINCHIP_WRITE(W5100S_IR, ~mask | getIR() ); // must be setted 0x10.
}

/**
@brief  This sets the maximum segment size of TCP in Active Mode), while in Passive Mode this is set by peer
*/
void setSn_MSS(SOCKET s, uint16 Sn_MSSR)
{
    IINCHIP_WRITE( W5100S_Sn_MSS0(s), (uint8)((Sn_MSSR & 0xff00) >> 8));
    IINCHIP_WRITE( W5100S_Sn_MSS1(s), (uint8)(Sn_MSSR & 0x00ff));
}

void setSn_TTL(SOCKET s, uint8 ttl)
{
    IINCHIP_WRITE( W5100S_Sn_TTL(s) , ttl);
}



