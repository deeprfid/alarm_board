; ****************************************************************
; F4A0 Bootloader Scatter File (64KB @ 0x0)
; ****************************************************************
LR_IROM1 0x00000000 0x00010000  {    ; load region size_region
    ER_IROM1 0x00000000 0x00010000  {  ; load address = execution address
        *.o (RESET, +First)
        *(InRoot$$Sections)
        .ANY (+RO)
        .ANY (+XO)
    }
    RW_IRAM1 0x20000000 0x00040000  {  ; RW data (256KB SRAM)
        .ANY (+RW +ZI)
        .ANY (RAMCODE)
    }
}
