+/* ===== v9.82j: HardFault 现场记录（强定义覆盖启动文件 [WEAK] 的 B . 空转，供调试器定位崩溃点）=====
+ * 崩了之后 CPU 停在下面 for(;;)，Keil Halt 后到 Watch 窗口读：
+ *   g_hf_pc  = 崩溃指令地址（映射 .map/axf 即得具体函数行）
+ *   g_hf_bfar/MMFAR = 出错访问地址（UAF 时是已释放堆地址）
+ *   g_hf_cfsr = 错误类型（bit1 DACCVIOL 数据访问违例 / bit9 PRECISERR 精确总线错 / bit16 未定义指令）
+ */
+volatile uint32_t g_hf_cfsr = 0;
+volatile uint32_t g_hf_hfsr = 0;
+volatile uint32_t g_hf_bfar = 0;
+volatile uint32_t g_hf_mmfar = 0;
+volatile uint32_t g_hf_pc   = 0;
+volatile uint32_t g_hf_lr   = 0;
+
+/* v9.82j: armcc 内联汇编——读 PSP（RTX 任务当前栈=异常帧所在），避免依赖 core_cm4.h */
+__asm uint32_t hf_get_psp(void)
+{
+    MRS     R0, PSP
+    BX      LR
+}
+
+void HardFault_Handler(void)
+{
+    volatile uint32_t *pSCB = (volatile uint32_t *)0xE000ED00UL;
+    uint32_t *frame;
+
+    g_hf_cfsr  = pSCB[0x28 >> 2];
+    g_hf_hfsr  = pSCB[0x2C >> 2];
+    g_hf_mmfar = pSCB[0x34 >> 2];
+    g_hf_bfar  = pSCB[0x38 >> 2];
+    frame = (uint32_t *)hf_get_psp();   /* RTX 任务用 PSP：异常帧 = R0,R1,R2,R3,R12,LR,PC,xPSR */
+    g_hf_pc = frame[6];
+    g_hf_lr = frame[5];
+    for (;;) { }
+}
